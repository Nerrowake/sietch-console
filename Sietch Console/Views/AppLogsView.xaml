<UserControl x:Class="Sietch_Console.Views.AppLogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SietchConsole.Core.Models;assembly=SietchConsole.Core"
             Background="{StaticResource AppBackground}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24,28,28">

                <!-- Page Header -->
                <TextBlock Style="{StaticResource PageTitleStyle}"
                           Text="App Logs"
                           Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="Internal Sietch Console log stream — useful for diagnosing configuration and service issues."
                           Margin="0,0,0,16" />

                <!-- Loading indicator -->
                <ProgressBar Style="{StaticResource LoadingBarStyle}"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             Margin="0,0,0,16" />

                <!-- ── Filter bar ── -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="16,12"
                        Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Search -->
                        <Border Grid.Column="0"
                                Background="{StaticResource FieldBackground}"
                                BorderBrush="{StaticResource BorderDefault}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerSmall}"
                                Padding="10,6">
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextPrimary}"
                                     FontFamily="{StaticResource FontUI}"
                                     FontSize="{StaticResource FontSizeBody}" />
                        </Border>

                        <!-- Level filter -->
                        <ComboBox Grid.Column="2"
                                  ItemsSource="{Binding LevelChoices}"
                                  SelectedItem="{Binding LevelFilter}"
                                  Background="{StaticResource FieldBackground}"
                                  Foreground="{StaticResource TextPrimary}"
                                  FontFamily="{StaticResource FontUI}"
                                  FontSize="{StaticResource FontSizeBody}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='{}Level: {0}', TargetNullValue='All levels'}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Refresh -->
                        <Button Grid.Column="4"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource InfoButtonStyle}"
                                Padding="12,6">
                            <TextBlock Text="Refresh" />
                        </Button>

                        <!-- Clear -->
                        <Button Grid.Column="6"
                                Command="{Binding ClearLogCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Padding="12,6">
                            <TextBlock Text="Clear" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Empty state -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="20,16"
                        Margin="0,0,0,8"
                        Visibility="{Binding HasEntries, Converter={StaticResource BoolToCollapsedConverter}}">
                    <Border Style="{StaticResource EmptyStateBorderStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource EmptyStateHeadingStyle}"
                                       Text="No log entries yet."
                                       Margin="0,0,0,6" />
                            <TextBlock Style="{StaticResource EmptyStateSubtextStyle}"
                                       Text="Log entries appear here as Sietch Console services run. Only Information level and above are captured."
                                       MaxWidth="420" />
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Log entry list -->
                <ItemsControl ItemsSource="{Binding Entries}"
                              Visibility="{Binding HasEntries, Converter={StaticResource BoolToVisibleConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:AppLogEntry}">
                            <Border Background="{StaticResource CardBackground}"
                                    BorderBrush="{StaticResource BorderSubtle}"
                                    BorderThickness="0,0,0,1"
                                    Padding="16,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="130" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Level badge -->
                                    <Border Grid.Column="0"
                                            CornerRadius="{StaticResource CornerSmall}"
                                            Padding="6,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource StatusInfoBg}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                        <Setter Property="Background" Value="{StaticResource StatusWarningBg}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Error">
                                                        <Setter Property="Background" Value="{StaticResource StatusErrorBg}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Level}" Value="Critical">
                                                        <Setter Property="Background" Value="{StaticResource StatusErrorBg}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontFamily="{StaticResource FontUI}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"       Value="{Binding Level}" />
                                                    <Setter Property="Foreground" Value="{StaticResource AccentCyan}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentAmber}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Error">
                                                            <Setter Property="Foreground" Value="{StaticResource StatusError}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Level}" Value="Critical">
                                                            <Setter Property="Foreground" Value="{StaticResource StatusError}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Category -->
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Category}"
                                               Style="{StaticResource MutedTextStyle}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Message -->
                                    <TextBlock Grid.Column="4"
                                               Text="{Binding Message}"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontFamily="{StaticResource FontUI}"
                                               FontSize="{StaticResource FontSizeBody}"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap" />

                                    <!-- Timestamp -->
                                    <TextBlock Grid.Column="5"
                                               Text="{Binding Timestamp, StringFormat='HH:mm:ss'}"
                                               Style="{StaticResource MutedTextStyle}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
