<UserControl x:Class="Sietch_Console.Views.Steps.ReviewStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="600" HorizontalAlignment="Center" Margin="40,28">

            <TextBlock Text="Review Configuration"
                       Style="{StaticResource CardTitleStyle}"
                       Margin="0,0,0,6" />
            <TextBlock Text="Review your selections below. Click 'Begin Setup' to start installation."
                       Style="{StaticResource MutedTextStyle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,24" />

            <!-- Paths -->
            <Border Style="{StaticResource CardStyle}" Padding="20,16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Installation Locations"
                               Style="{StaticResource SectionLabelStyle}"
                               Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Server Files" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding InstallPath}"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Backups" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding BackupPath}"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Logs" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding LogsPath}"
                                   Style="{StaticResource BodyTextStyle}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- VM -->
            <Border Style="{StaticResource CardStyle}" Padding="20,16" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Virtual Machine"
                               Style="{StaticResource SectionLabelStyle}"
                               Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding VmName}" Style="{StaticResource BodyTextStyle}" />
                    </Grid>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Memory" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding VmMemory}" Style="{StaticResource BodyTextStyle}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Network" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding NetworkAdapter}" Style="{StaticResource BodyTextStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Battlegroup -->
            <Border Style="{StaticResource CardStyle}" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Battlegroup"
                               Style="{StaticResource SectionLabelStyle}"
                               Margin="0,0,0,12" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding BattlegroupName}" Style="{StaticResource BodyTextStyle}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Servers" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Grid.Column="1" Text="{Binding ServerCount}" Style="{StaticResource BodyTextStyle}" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
