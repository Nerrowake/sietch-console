<UserControl x:Class="Sietch_Console.Views.Steps.RequirementsStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SietchConsole.Core.Models;assembly=SietchConsole.Core">
    <UserControl.Resources>
        <Style x:Key="SeverityStripeStyle" TargetType="Border">
            <Setter Property="Width" Value="4" />
            <Setter Property="Background" Value="{StaticResource StatusOffline}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Pass">
                    <Setter Property="Background" Value="{StaticResource StatusSuccess}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Background" Value="{StaticResource StatusWarning}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Failure">
                    <Setter Property="Background" Value="{StaticResource StatusError}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResultCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerMedium}" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="ClipToBounds" Value="True" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Pass">
                    <Setter Property="Background" Value="{StaticResource StatusSuccessBg}" />
                    <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessBorder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Background" Value="{StaticResource StatusWarningBg}" />
                    <Setter Property="BorderBrush" Value="{StaticResource StatusWarningBorder}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Failure">
                    <Setter Property="Background" Value="{StaticResource StatusErrorBg}" />
                    <Setter Property="BorderBrush" Value="{StaticResource StatusErrorBorder}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate DataType="{x:Type models:DiagnosticsResult}">
            <Border Style="{StaticResource ResultCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SeverityStripeStyle}" />
                    <StackPanel Grid.Column="1" Margin="12,10,12,10">
                        <TextBlock Text="{Binding CheckName}"
                                   Style="{StaticResource MutedTextStyle}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Margin="0,0,0,2" />
                        <TextBlock Text="{Binding Title}"
                                   Style="{StaticResource BodyTextStyle}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding FriendlyMessage}"
                                   Style="{StaticResource BodyTextStyle}"
                                   Foreground="{StaticResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Margin="0,4,0,0"
                                   Visibility="{Binding FriendlyMessage, Converter={StaticResource NullToCollapsedConverter}}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header + Run button -->
        <StackPanel Grid.Row="0" Margin="28,20,28,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="System Requirements"
                               Style="{StaticResource CardTitleStyle}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Your system must meet these requirements before setup can continue."
                               Style="{StaticResource MutedTextStyle}"
                               TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1"
                        Command="{Binding RunChecksCommand}"
                        IsEnabled="{Binding IsRunning, Converter={StaticResource BoolInverseConverter}}"
                        Padding="14,8"
                        Background="{StaticResource AccentPrimary}"
                        Foreground="{StaticResource TextPrimary}"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="{StaticResource CornerMedium}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentAmber}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="{StaticResource BorderDefault}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <TextBlock>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Run Checks" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                        <Setter Property="Text" Value="Running…" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </Grid>

            <!-- Proceed despite failures checkbox -->
            <Border Margin="0,12,0,0"
                    Padding="12,10"
                    Background="{StaticResource StatusErrorBg}"
                    BorderBrush="{StaticResource StatusErrorBorder}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerSmall}"
                    Visibility="{Binding HasFailures, Converter={StaticResource BoolToVisibleConverter}}">
                <CheckBox IsChecked="{Binding ProceedDespiteFailures}"
                          Foreground="{StaticResource StatusError}"
                          FontSize="{StaticResource FontSizeSmall}">
                    I understand the risks and want to proceed anyway
                </CheckBox>
            </Border>
        </StackPanel>

        <!-- Results list -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Margin="28,0,28,16">
            <StackPanel>
                <!-- Empty state -->
                <Border Padding="30"
                        Style="{StaticResource CardStyle}"
                        Visibility="{Binding HasResults, Converter={StaticResource BoolToCollapsedConverter}}">
                    <TextBlock Text="Click 'Run Checks' to verify your system."
                               Style="{StaticResource MutedTextStyle}"
                               HorizontalAlignment="Center" />
                </Border>
                <ItemsControl ItemsSource="{Binding Results}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
