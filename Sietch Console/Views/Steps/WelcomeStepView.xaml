<UserControl x:Class="Sietch_Console.Views.Steps.WelcomeStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="560" HorizontalAlignment="Center" Margin="40,40">

            <Border Width="56" Height="56"
                    Background="{StaticResource OverlayBackground}"
                    BorderBrush="{StaticResource AccentPrimary}"
                    BorderThickness="2"
                    CornerRadius="{StaticResource CornerLarge}"
                    HorizontalAlignment="Center"
                    Margin="0,0,0,24">
                <TextBlock Text="⌂"
                           Foreground="{StaticResource AccentPrimary}"
                           FontSize="26"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="Welcome to Sietch Console"
                       Style="{StaticResource PageTitleStyle}"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"
                       Margin="0,0,0,12" />

            <TextBlock Foreground="{StaticResource TextSecondary}"
                       FontSize="{StaticResource FontSizeBody}"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,28"
                       LineHeight="22">
                This wizard will guide you through configuring and launching your
                Dune: Awakening battlegroup. It typically takes 10–20 minutes depending
                on your internet speed and hardware.
            </TextBlock>

            <Border Style="{StaticResource CardStyle}" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="This wizard will:"
                               Foreground="{StaticResource AccentSandstone}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12" />
                    <ItemsControl>
                        <ItemsControl.Items>
                            <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Verify your system meets all requirements</System:String>
                            <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Choose installation and backup locations</System:String>
                            <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Enter your Dune account token</System:String>
                            <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Configure your Hyper-V virtual machine</System:String>
                            <System:String xmlns:System="clr-namespace:System;assembly=mscorlib">Set up and launch your battlegroup</System:String>
                        </ItemsControl.Items>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Ellipse Width="6" Height="6"
                                             Fill="{StaticResource AccentPrimary}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,10,0" />
                                    <TextBlock Text="{Binding}"
                                               Style="{StaticResource BodyTextStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource MutedTextStyle}"
                       Text="Click Next to begin. You can go back to any step at any time."
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,20,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
