<UserControl x:Class="Sietch_Console.Views.Steps.TokenStepView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="560" HorizontalAlignment="Center" Margin="40,28">

            <TextBlock Text="Dune Account Token"
                       Style="{StaticResource CardTitleStyle}"
                       Margin="0,0,0,6" />
            <TextBlock Text="Your account token is used to authenticate the dedicated server with Funcom's services."
                       Style="{StaticResource MutedTextStyle}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,24" />

            <Border Style="{StaticResource CardStyle}" Padding="20,16" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Where to find your token:"
                               Foreground="{StaticResource AccentSandstone}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,10" />
                    <TextBlock TextWrapping="Wrap"
                               Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource TextSecondary}"
                               LineHeight="22">
                        1. Log in to your Dune: Awakening account portal&#x0a;
                        2. Navigate to Account Settings → Server Hosting&#x0a;
                        3. Generate or copy your existing Server Token
                    </TextBlock>
                </StackPanel>
            </Border>

            <TextBlock Text="Enter your token:"
                       Style="{StaticResource SectionLabelStyle}"
                       Margin="0,0,0,8" />

            <Border Background="{StaticResource FieldBackground}"
                    BorderBrush="{StaticResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerSmall}"
                    Padding="12,10">
                <TextBox Text="{Binding Token, UpdateSourceTrigger=PropertyChanged}"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{StaticResource TextPrimary}"
                         FontFamily="{StaticResource FontMono}"
                         FontSize="{StaticResource FontSizeSmall}"
                         CaretBrush="{StaticResource AccentPrimary}" />
            </Border>

            <!-- #180 – Inline validation error -->
            <TextBlock Text="{Binding TokenError}"
                       Foreground="{StaticResource StatusError}"
                       FontFamily="{StaticResource FontUI}"
                       FontSize="12"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding TokenError, Converter={StaticResource NullToCollapsedConverter}}" />

            <Border Margin="0,12,0,0"
                    Padding="12,10"
                    Background="{StaticResource StatusWarningBg}"
                    BorderBrush="{StaticResource StatusWarningBorder}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerSmall}">
                <TextBlock TextWrapping="Wrap"
                           FontSize="{StaticResource FontSizeSmall}"
                           Foreground="{StaticResource StatusWarning}">
                    Keep your token private. Do not share it with others.
                    Anyone with your token can control your server account.
                </TextBlock>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
