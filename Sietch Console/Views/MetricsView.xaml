<UserControl x:Class="Sietch_Console.Views.MetricsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:oxy="http://oxyplot.org/wpf"
             Background="{StaticResource AppBackground}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24,28,28">

                <!-- Page Header -->
                <TextBlock Style="{StaticResource PageTitleStyle}"
                           Text="Metrics"
                           Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="Historical server health data — CPU, memory, player count, and uptime."
                           Margin="0,0,0,16" />

                <!-- Loading bar -->
                <ProgressBar Style="{StaticResource LoadingBarStyle}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibleConverter}}"
                             Margin="0,0,0,16" />

                <!-- Time range + collecting status bar -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="16,12"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="220" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource FieldLabelStyle}"
                                   Text="Time range:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0" />

                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding TimeRangeOptions}"
                                  SelectedIndex="{Binding SelectedTimeRangeIndex}"
                                  Foreground="{StaticResource TextPrimary}"
                                  Background="{StaticResource FieldBackground}"
                                  FontFamily="{StaticResource FontUI}"
                                  FontSize="{StaticResource FontSizeBody}" />

                        <!-- Live indicator -->
                        <StackPanel Grid.Column="3"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding IsCollecting, Converter={StaticResource BoolToVisibleConverter}}">
                            <Ellipse Width="8" Height="8"
                                     Margin="0,0,8,0"
                                     Fill="{StaticResource StatusRunning}" />
                            <TextBlock Text="Collecting"
                                       Foreground="{StaticResource StatusRunning}"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="{StaticResource FontSizeSmall}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Uptime summary ──────────────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="20,16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Style="{StaticResource CardTitleStyle}"
                                       Text="Availability"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="{Binding AvailabilityPct}"
                                       Foreground="{StaticResource AccentCyan}"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="28"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding UptimeSummary}"
                                       Style="{StaticResource MutedTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitleStyle}"
                                       Text="Status"
                                       Margin="0,0,0,4" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10"
                                         Margin="0,0,8,0"
                                         Fill="{StaticResource StatusRunning}"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding IsCollecting, Converter={StaticResource BoolToVisibleConverter}}" />
                                <Ellipse Width="10" Height="10"
                                         Margin="0,0,8,0"
                                         Fill="{StaticResource StatusOffline}"
                                         VerticalAlignment="Center"
                                         Visibility="{Binding IsCollecting, Converter={StaticResource BoolToCollapsedConverter}}" />
                                <TextBlock Text="Live"
                                           Foreground="{StaticResource StatusRunning}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsCollecting, Converter={StaticResource BoolToVisibleConverter}}" />
                                <TextBlock Text="Server offline"
                                           Foreground="{StaticResource StatusOffline}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           VerticalAlignment="Center"
                                           Visibility="{Binding IsCollecting, Converter={StaticResource BoolToCollapsedConverter}}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Player Count chart ─────────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="20,16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}"
                                   Text="Player Count"
                                   Margin="0,0,0,12" />
                        <oxy:PlotView Model="{Binding PlayerCountModel}"
                                      Height="160"
                                      Background="Transparent" />
                    </StackPanel>
                </Border>

                <!-- ── CPU chart ──────────────────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="20,16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}"
                                   Text="CPU Utilisation"
                                   Margin="0,0,0,12" />
                        <oxy:PlotView Model="{Binding CpuModel}"
                                      Height="160"
                                      Background="Transparent" />
                    </StackPanel>
                </Border>

                <!-- ── Memory chart ───────────────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="20,16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}"
                                   Text="Memory Usage"
                                   Margin="0,0,0,12" />
                        <oxy:PlotView Model="{Binding MemoryModel}"
                                      Height="160"
                                      Background="Transparent" />
                    </StackPanel>
                </Border>

                <!-- ── Downtime events ────────────────────────────────────── -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="20,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}"
                                   Text="Downtime Events"
                                   Margin="0,0,0,12" />

                        <!-- Event list -->
                        <ItemsControl ItemsSource="{Binding DowntimeEvents}"
                                      Visibility="{Binding HasDowntimeEvents, Converter={StaticResource BoolToVisibleConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBackground}"
                                            CornerRadius="{StaticResource CornerSmall}"
                                            Padding="14,10"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Reason}"
                                                           Foreground="{StaticResource TextPrimary}"
                                                           FontFamily="{StaticResource FontUI}"
                                                           FontSize="{StaticResource FontSizeBody}" />
                                                <TextBlock Foreground="{StaticResource TextMuted}"
                                                           FontFamily="{StaticResource FontUI}"
                                                           FontSize="{StaticResource FontSizeSmall}"
                                                           Margin="0,2,0,0">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="Started {0:yyyy-MM-dd HH:mm}">
                                                            <Binding Path="StartedAt" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </StackPanel>

                                            <!-- Open badge -->
                                            <Border Grid.Column="1"
                                                    Background="{StaticResource StatusWarningBg}"
                                                    CornerRadius="{StaticResource CornerSmall}"
                                                    Padding="8,3"
                                                    Margin="12,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibleConverter}}">
                                                <TextBlock Text="Open"
                                                           Foreground="{StaticResource StatusWarning}"
                                                           FontFamily="{StaticResource FontUI}"
                                                           FontSize="{StaticResource FontSizeSmall}" />
                                            </Border>

                                            <!-- Duration -->
                                            <TextBlock Grid.Column="2"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontFamily="{StaticResource FontMono}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       VerticalAlignment="Center"
                                                       Visibility="{Binding IsOpen, Converter={StaticResource BoolToCollapsedConverter}}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0:hh\\:mm}">
                                                        <Binding Path="Duration" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Empty state -->
                        <Border Style="{StaticResource EmptyStateBorderStyle}"
                                Visibility="{Binding HasDowntimeEvents, Converter={StaticResource BoolToCollapsedConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource EmptyStateHeadingStyle}"
                                           Text="No downtime recorded."
                                           Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource EmptyStateSubtextStyle}"
                                           Text="Server outages will appear here automatically."
                                           MaxWidth="420" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
