<UserControl x:Class="Sietch_Console.Views.SetupWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" />
            <RowDefinition Height="72" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="28,24,28,20">
            <TextBlock Style="{StaticResource PageTitleStyle}"
                       Text="Setup Wizard"
                       Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="Follow the steps below to configure and launch your battlegroup." />
        </StackPanel>

        <!-- ═══════════════════════════════════════ -->
        <!-- Step Indicator Bar                      -->
        <!-- ═══════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderDefault}"
                BorderThickness="0,1,0,1"
                Padding="28,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Step 1: Welcome (active) -->
                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                    <Border Width="28" Height="28"
                            Background="{StaticResource AccentPrimary}"
                            CornerRadius="{StaticResource CornerRound}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,6">
                        <TextBlock Text="1"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Welcome"
                               Foreground="{StaticResource TextPrimary}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeSmall}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <Rectangle Grid.Column="1" Height="1"
                           Fill="{StaticResource BorderDefault}"
                           VerticalAlignment="Top" Margin="4,13,4,0" />

                <!-- Step 2: Requirements -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                    <Border Width="28" Height="28"
                            Background="{StaticResource OverlayBackground}"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRound}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,6">
                        <TextBlock Text="2"
                                   Foreground="{StaticResource TextDisabled}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Requirements"
                               Foreground="{StaticResource TextDisabled}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeSmall}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <Rectangle Grid.Column="3" Height="1"
                           Fill="{StaticResource BorderDefault}"
                           VerticalAlignment="Top" Margin="4,13,4,0" />

                <!-- Step 3: Location -->
                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                    <Border Width="28" Height="28"
                            Background="{StaticResource OverlayBackground}"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRound}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,6">
                        <TextBlock Text="3"
                                   Foreground="{StaticResource TextDisabled}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Location"
                               Foreground="{StaticResource TextDisabled}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeSmall}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <Rectangle Grid.Column="5" Height="1"
                           Fill="{StaticResource BorderDefault}"
                           VerticalAlignment="Top" Margin="4,13,4,0" />

                <!-- Step 4: Token -->
                <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                    <Border Width="28" Height="28"
                            Background="{StaticResource OverlayBackground}"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRound}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,6">
                        <TextBlock Text="4"
                                   Foreground="{StaticResource TextDisabled}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Token"
                               Foreground="{StaticResource TextDisabled}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeSmall}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <Rectangle Grid.Column="7" Height="1"
                           Fill="{StaticResource BorderDefault}"
                           VerticalAlignment="Top" Margin="4,13,4,0" />

                <!-- Step 5: VM Setup -->
                <StackPanel Grid.Column="8" HorizontalAlignment="Center">
                    <Border Width="28" Height="28"
                            Background="{StaticResource OverlayBackground}"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRound}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,6">
                        <TextBlock Text="5"
                                   Foreground="{StaticResource TextDisabled}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="VM Setup"
                               Foreground="{StaticResource TextDisabled}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeSmall}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <Rectangle Grid.Column="9" Height="1"
                           Fill="{StaticResource BorderDefault}"
                           VerticalAlignment="Top" Margin="4,13,4,0" />

                <!-- Step 6: Battlegroup -->
                <StackPanel Grid.Column="10" HorizontalAlignment="Center">
                    <Border Width="28" Height="28"
                            Background="{StaticResource OverlayBackground}"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRound}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,6">
                        <TextBlock Text="6"
                                   Foreground="{StaticResource TextDisabled}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Battlegroup"
                               Foreground="{StaticResource TextDisabled}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeSmall}"
                               HorizontalAlignment="Center" />
                </StackPanel>

                <Rectangle Grid.Column="11" Height="1"
                           Fill="{StaticResource BorderDefault}"
                           VerticalAlignment="Top" Margin="4,13,4,0" />

                <!-- Step 7: Review -->
                <StackPanel Grid.Column="12" HorizontalAlignment="Center">
                    <Border Width="28" Height="28"
                            Background="{StaticResource OverlayBackground}"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerRound}"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,6">
                        <TextBlock Text="7"
                                   Foreground="{StaticResource TextDisabled}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="Review"
                               Foreground="{StaticResource TextDisabled}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeSmall}"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Rectangle Grid.Row="2" Fill="{StaticResource BorderDefault}" />

        <!-- ═══════════════════════════════════════ -->
        <!-- Step Content: Welcome                   -->
        <!-- ═══════════════════════════════════════ -->
        <ScrollViewer Grid.Row="3"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel MaxWidth="600"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="40,40">

                <Border Width="56" Height="56"
                        Background="{StaticResource OverlayBackground}"
                        BorderBrush="{StaticResource AccentPrimary}"
                        BorderThickness="2"
                        CornerRadius="{StaticResource CornerLarge}"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,24">
                    <TextBlock Text="⌂"
                               Foreground="{StaticResource AccentPrimary}"
                               FontSize="28"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="Welcome to Sietch Console"
                           Foreground="{StaticResource TextPrimary}"
                           FontFamily="{StaticResource FontUI}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,0,0,12" />

                <TextBlock Foreground="{StaticResource TextSecondary}"
                           FontFamily="{StaticResource FontUI}"
                           FontSize="{StaticResource FontSizeBody}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,0,28"
                           LineHeight="22">
                    This wizard will guide you through setting up your Dune: Awakening battlegroup.
                    It typically takes 10–20 minutes to complete, depending on your internet speed and hardware.
                </TextBlock>

                <Border Style="{StaticResource CardStyle}" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="This wizard will help you:"
                                   Foreground="{StaticResource AccentSandstone}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12" />

                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <Ellipse Width="6" Height="6"
                                     Fill="{StaticResource AccentPrimary}"
                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Verify your system meets all requirements"
                                       Style="{StaticResource BodyTextStyle}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <Ellipse Width="6" Height="6"
                                     Fill="{StaticResource AccentPrimary}"
                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Choose an installation location"
                                       Style="{StaticResource BodyTextStyle}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <Ellipse Width="6" Height="6"
                                     Fill="{StaticResource AccentPrimary}"
                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Enter your Dune account token"
                                       Style="{StaticResource BodyTextStyle}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <Ellipse Width="6" Height="6"
                                     Fill="{StaticResource AccentPrimary}"
                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Set up the Hyper-V virtual machine"
                                       Style="{StaticResource BodyTextStyle}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6"
                                     Fill="{StaticResource AccentPrimary}"
                                     VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Configure and launch your battlegroup"
                                       Style="{StaticResource BodyTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource MutedTextStyle}"
                           Text="Click Next to begin. You can return to any step using the Back button."
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,20,0,0" />
            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════ -->
        <!-- Navigation Buttons                      -->
        <!-- ═══════════════════════════════════════ -->
        <Border Grid.Row="4"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderDefault}"
                BorderThickness="0,1,0,0">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Step 1 of 7"
                           Foreground="{StaticResource TextMuted}"
                           FontFamily="{StaticResource FontUI}"
                           FontSize="12"
                           VerticalAlignment="Center" />

                <Border Grid.Column="1"
                        Width="100" Height="36"
                        Background="{StaticResource OverlayBackground}"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerMedium}"
                        Opacity="0.4">
                    <TextBlock Text="← Back"
                               Foreground="{StaticResource TextSecondary}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeBody}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <Border Grid.Column="3"
                        Width="120" Height="36"
                        Background="{StaticResource AccentPrimary}"
                        CornerRadius="{StaticResource CornerMedium}">
                    <TextBlock Text="Next →"
                               Foreground="{StaticResource TextPrimary}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
