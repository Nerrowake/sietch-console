<UserControl x:Class="Sietch_Console.Views.SetupWizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackground}">

    <UserControl.Resources>

        <Style x:Key="StepPillStyle" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="{StaticResource OverlayBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource CornerRound}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentPrimary}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentPrimary}" />
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentTeal}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentTeal}" />
                    <Setter Property="BorderThickness" Value="0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StepLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
            <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentTeal}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="StepNumberStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextDisabled}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                    <Setter Property="Text" Value="✓" />
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Page header -->
        <StackPanel Grid.Row="0" Margin="28,20,28,16">
            <TextBlock Text="Setup Wizard"
                       Style="{StaticResource PageTitleStyle}"
                       Margin="0,0,0,4" />
            <TextBlock Text="Follow the steps below to configure and launch your battlegroup."
                       Style="{StaticResource MutedTextStyle}" />
        </StackPanel>

        <!-- Step indicator bar -->
        <Border Grid.Row="1"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderDefault}"
                BorderThickness="0,1,0,1"
                Padding="28,14">
            <ItemsControl ItemsSource="{Binding StepIndicators}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel HorizontalAlignment="Center" Margin="4,0">
                            <Border Style="{StaticResource StepPillStyle}">
                                <TextBlock Style="{StaticResource StepNumberStyle}" />
                            </Border>
                            <TextBlock Text="{Binding Title}"
                                       Style="{StaticResource StepLabelStyle}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Resume offer overlay -->
        <Grid Grid.Row="2"
              Visibility="{Binding HasResumeOffer, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="{StaticResource AppBackground}" Opacity="0.9" />
            <Border MaxWidth="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Style="{StaticResource CardStyle}"
                    Padding="28,24">
                <StackPanel>
                    <TextBlock Text="Resume Previous Setup?"
                               Style="{StaticResource CardTitleStyle}"
                               Margin="0,0,0,8" />
                    <TextBlock Text="A previous setup session was found. Continue where you left off, or start fresh?"
                               Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource TextSecondary}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding StartFreshCommand}"
                                Padding="16,9"
                                Margin="0,0,10,0"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{StaticResource OverlayBackground}"
                                                        BorderBrush="{StaticResource BorderDefault}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource CornerMedium}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource HoverBackground}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="Start Fresh" Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource TextSecondary}" />
                        </Button>
                        <Button Command="{Binding ResumeCommand}"
                                Padding="16,9"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{StaticResource AccentPrimary}"
                                                        CornerRadius="{StaticResource CornerMedium}"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentAmber}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="Resume" Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Current step content -->
        <ContentControl Grid.Row="2"
                        Content="{Binding CurrentStep}"
                        Visibility="{Binding HasResumeOffer, Converter={StaticResource BoolToCollapsedConverter}}" />

        <!-- Navigation buttons -->
        <Border Grid.Row="3"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderDefault}"
                BorderThickness="0,1,0,0"
                Padding="28,0"
                Height="64">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StepLabel}"
                           Style="{StaticResource MutedTextStyle}"
                           VerticalAlignment="Center" />

                <Button Grid.Column="1"
                        Command="{Binding GoBackCommand}"
                        Width="100" Height="36"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{StaticResource OverlayBackground}"
                                                BorderBrush="{StaticResource BorderDefault}"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource CornerMedium}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.35" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource HoverBackground}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="← Back" Style="{StaticResource BodyTextStyle}" Foreground="{StaticResource TextSecondary}" />
                </Button>

                <Button Grid.Column="3"
                        Command="{Binding GoNextCommand}"
                        IsEnabled="{Binding CurrentStepCanProceed}"
                        Width="140" Height="36"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{StaticResource AccentPrimary}"
                                                CornerRadius="{StaticResource CornerMedium}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentAmber}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="{StaticResource BorderDefault}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                    <TextBlock Text="{Binding NextLabel}"
                               Style="{StaticResource BodyTextStyle}"
                               Foreground="{StaticResource TextPrimary}"
                               FontWeight="SemiBold" />
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
