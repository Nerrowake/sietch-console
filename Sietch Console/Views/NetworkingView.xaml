<UserControl x:Class="Sietch_Console.Views.NetworkingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sietch_Console.ViewModels"
             xmlns:models="clr-namespace:SietchConsole.Core.Models;assembly=SietchConsole.Core"
             Background="{StaticResource AppBackground}">

    <UserControl.DataContext>
        <Binding />
    </UserControl.DataContext>

    <UserControl.Resources>

        <!-- ── Protocol badge (UDP = cyan, TCP = sandstone) ─────── -->
        <Style x:Key="ProtocolBadgeStyle" TargetType="Border">
            <Setter Property="CornerRadius"    Value="{StaticResource CornerSmall}" />
            <Setter Property="Padding"         Value="6,2" />
            <Setter Property="Background"      Value="{StaticResource StatusInfoBg}" />
            <Setter Property="BorderBrush"     Value="{StaticResource AccentCyan}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- ── Required-port row DataTemplate ───────────────────── -->
        <DataTemplate DataType="{x:Type models:BattlegroupPort}">
            <Border BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0,0,0,1"
                    Padding="0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Port number -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding Port}"
                               Foreground="{StaticResource TextPrimary}"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="{StaticResource FontSizeBody}"
                               VerticalAlignment="Center" />

                    <!-- Protocol badge -->
                    <Border Grid.Column="1"
                            Style="{StaticResource ProtocolBadgeStyle}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Protocol}"
                                   Foreground="{StaticResource AccentCyan}"
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </Border>

                    <!-- Name -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding Name}"
                               Foreground="{StaticResource TextSecondary}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeBody}"
                               VerticalAlignment="Center" />

                    <!-- Purpose -->
                    <TextBlock Grid.Column="3"
                               Text="{Binding Purpose}"
                               Foreground="{StaticResource TextMuted}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- ── Firewall-status row DataTemplate ─────────────────── -->
        <DataTemplate DataType="{x:Type models:FirewallRuleStatus}">
            <Border BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0,0,0,1"
                    Padding="0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Port number -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding Port.Port}"
                               Foreground="{StaticResource TextPrimary}"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="{StaticResource FontSizeBody}"
                               VerticalAlignment="Center" />

                    <!-- Protocol badge -->
                    <Border Grid.Column="1"
                            Style="{StaticResource ProtocolBadgeStyle}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Port.Protocol}"
                                   Foreground="{StaticResource AccentCyan}"
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </Border>

                    <!-- Name -->
                    <TextBlock Grid.Column="2"
                               Text="{Binding Port.Name}"
                               Foreground="{StaticResource TextSecondary}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeBody}"
                               VerticalAlignment="Center" />

                    <!-- Status badge -->
                    <Border Grid.Column="3"
                            x:Name="StatusBadge"
                            CornerRadius="{StaticResource CornerSmall}"
                            Padding="8,3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{StaticResource StatusErrorBg}"
                            BorderBrush="{StaticResource StatusError}"
                            BorderThickness="1">
                        <TextBlock x:Name="StatusLabel"
                                   Text="Missing"
                                   Foreground="{StaticResource StatusError}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsConfigured}" Value="True">
                    <Setter TargetName="StatusBadge" Property="Background"
                            Value="{StaticResource StatusSuccessBg}" />
                    <Setter TargetName="StatusBadge" Property="BorderBrush"
                            Value="{StaticResource StatusSuccess}" />
                    <Setter TargetName="StatusLabel" Property="Text"
                            Value="Rule Found" />
                    <Setter TargetName="StatusLabel" Property="Foreground"
                            Value="{StaticResource StatusSuccess}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ── Connectivity-result row DataTemplate ──────────────── -->
        <DataTemplate DataType="{x:Type models:ConnectivityResult}">
            <Border BorderBrush="{StaticResource BorderSubtle}"
                    BorderThickness="0,0,0,1"
                    Padding="0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding Port.Port}"
                               Foreground="{StaticResource TextPrimary}"
                               FontFamily="{StaticResource FontMono}"
                               FontSize="{StaticResource FontSizeBody}"
                               VerticalAlignment="Center" />

                    <Border Grid.Column="1"
                            Style="{StaticResource ProtocolBadgeStyle}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding Port.Protocol}"
                                   Foreground="{StaticResource AccentCyan}"
                                   FontFamily="{StaticResource FontMono}"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                    </Border>

                    <TextBlock Grid.Column="2"
                               Text="{Binding Port.Name}"
                               Foreground="{StaticResource TextSecondary}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeBody}"
                               VerticalAlignment="Center" />

                    <Border Grid.Column="3"
                            x:Name="ConnBadge"
                            CornerRadius="{StaticResource CornerSmall}"
                            Padding="8,3"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{StaticResource StatusWarningBg}"
                            BorderBrush="{StaticResource StatusWarning}"
                            BorderThickness="1">
                        <TextBlock x:Name="ConnLabel"
                                   Text="Not Listening"
                                   Foreground="{StaticResource StatusWarning}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsListening}" Value="True">
                    <Setter TargetName="ConnBadge" Property="Background"
                            Value="{StaticResource StatusSuccessBg}" />
                    <Setter TargetName="ConnBadge" Property="BorderBrush"
                            Value="{StaticResource StatusSuccess}" />
                    <Setter TargetName="ConnLabel" Property="Text"
                            Value="Listening" />
                    <Setter TargetName="ConnLabel" Property="Foreground"
                            Value="{StaticResource StatusSuccess}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24,20" MaxWidth="860">

            <!-- ── Page header ─────────────────────────────────────── -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Networking"
                               Style="{StaticResource PageTitleStyle}" />
                    <TextBlock Text="Port requirements, firewall setup, and connection details for your battlegroup."
                               Style="{StaticResource PageSubtitleStyle}"
                               Margin="0,4,0,0" />
                </StackPanel>

                <Button Grid.Column="1"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource BoolInverseConverter}}"
                        Style="{StaticResource TealButtonStyle}"
                        VerticalAlignment="Top">
                    <TextBlock Text="Refresh" />
                </Button>
            </Grid>

            <!-- Loading bar while network operations run -->
            <ProgressBar Style="{StaticResource LoadingBarStyle}"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibleConverter}}"
                         Margin="0,0,0,12" />

            <!-- ── Status message ──────────────────────────────────── -->
            <TextBlock Text="{Binding StatusMessage}"
                       Foreground="{StaticResource AccentSandstone}"
                       FontFamily="{StaticResource FontUI}"
                       FontSize="{StaticResource FontSizeBody}"
                       Margin="0,0,0,12"
                       Visibility="{Binding StatusMessage,
                           Converter={StaticResource NullToCollapsedConverter}}" />

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- CARD 1 — Network Information (#84, #85)               -->
            <!-- ══════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="NETWORK INFORMATION"
                               Style="{StaticResource SectionLabelStyle}"
                               Margin="0,0,0,14" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Host -->
                        <Border Grid.Column="0"
                                Background="{StaticResource SurfaceBackground}"
                                BorderBrush="{StaticResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerMedium}"
                                Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="HOST MACHINE"
                                           Style="{StaticResource SectionLabelStyle}"
                                           Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="LAN IP"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="12"
                                               Width="80" />
                                    <TextBlock Text="{Binding HostIp}"
                                               Foreground="{StaticResource AccentCyan}"
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="{StaticResource FontSizeBody}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="Adapter"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="12"
                                               Width="80" />
                                    <TextBlock Text="{Binding HostAdapter}"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="12" />
                                </StackPanel>
                                <!-- #181 – Adapter picker (only shown when multiple adapters exist) -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,6,0,0"
                                            Visibility="{Binding HasMultipleAdapters, Converter={StaticResource BoolToVisibleConverter}}">
                                    <TextBlock Text="Override"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="12"
                                               Width="80"
                                               VerticalAlignment="Center" />
                                    <ComboBox ItemsSource="{Binding AvailableAdapters}"
                                              SelectedItem="{Binding SelectedHostAdapter}"
                                              MinWidth="180"
                                              Background="{StaticResource FieldBackground}"
                                              Foreground="{StaticResource TextSecondary}"
                                              BorderBrush="{StaticResource BorderDefault}"
                                              FontFamily="{StaticResource FontUI}"
                                              FontSize="12"
                                              Padding="6,4">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="{Binding Name}" />
                                                    <Run Text=" — " Foreground="{StaticResource TextMuted}" />
                                                    <Run Text="{Binding IpAddress}"
                                                         FontFamily="{StaticResource FontMono}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- VM -->
                        <Border Grid.Column="2"
                                Background="{StaticResource SurfaceBackground}"
                                BorderBrush="{StaticResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerMedium}"
                                Padding="14,12">
                            <StackPanel>
                                <TextBlock Text="HYPER-V VM"
                                           Style="{StaticResource SectionLabelStyle}"
                                           Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="VM IP"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="12"
                                               Width="80" />
                                    <TextBlock Text="{Binding VmIp}"
                                               Foreground="{StaticResource AccentSandstone}"
                                               FontFamily="{StaticResource FontMono}"
                                               FontSize="{StaticResource FontSizeBody}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Adapter"
                                               Foreground="{StaticResource TextMuted}"
                                               FontSize="12"
                                               Width="80" />
                                    <TextBlock Text="{Binding VmAdapter}"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontSize="12" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- CARD 2 — Required Ports (#83)                         -->
            <!-- ══════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="REQUIRED PORTS"
                               Style="{StaticResource SectionLabelStyle}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="These ports must be open in your router and Windows Firewall for the battlegroup to be accessible."
                               Foreground="{StaticResource TextMuted}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="12"
                               Margin="0,0,0,14" />

                    <!-- Column headers -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PORT"   Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock Grid.Column="1" Text="PROTO"  Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock Grid.Column="2" Text="NAME"   Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock Grid.Column="3" Text="PURPOSE" Style="{StaticResource SectionLabelStyle}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RequiredPorts}" />
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- CARD 3 — Firewall Status (#87, #88)                   -->
            <!-- ══════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="WINDOWS FIREWALL"
                                       Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Text="Inbound rules required for battlegroup traffic."
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="12"
                                       Margin="0,2,0,0" />
                        </StackPanel>

                        <Button Grid.Column="1"
                                Command="{Binding CreateFirewallRulesCommand}"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource BoolInverseConverter}}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding HasFirewallIssues, Converter={StaticResource BoolToVisibleConverter}}"
                                VerticalAlignment="Center">
                            <TextBlock Text="Create Missing Rules" />
                        </Button>
                    </Grid>

                    <!-- All-OK banner -->
                    <Border Background="{StaticResource StatusSuccessBg}"
                            BorderBrush="{StaticResource StatusSuccess}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerMedium}"
                            Padding="14,10"
                            Margin="0,0,0,12"
                            Visibility="{Binding AllFirewallRulesOk, Converter={StaticResource BoolToVisibleConverter}}">
                        <TextBlock Text="All firewall rules are configured."
                                   Foreground="{StaticResource StatusSuccess}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="{StaticResource FontSizeBody}" />
                    </Border>

                    <!-- Column headers -->
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition Width="60" />
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PORT"   Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock Grid.Column="1" Text="PROTO"  Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock Grid.Column="2" Text="NAME"   Style="{StaticResource SectionLabelStyle}" />
                        <TextBlock Grid.Column="3" Text="STATUS" Style="{StaticResource SectionLabelStyle}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding FirewallStatuses}" />

                    <!-- UAC note -->
                    <TextBlock Text="Creating firewall rules will show a Windows UAC prompt to allow the change."
                               Foreground="{StaticResource TextMuted}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="12"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- CARD 4 — Port Forwarding Guidance (#86)               -->
            <!-- ══════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <TextBlock Text="PORT FORWARDING GUIDE"
                               Style="{StaticResource SectionLabelStyle}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Required for players outside your home network to connect."
                               Foreground="{StaticResource TextMuted}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="12"
                               Margin="0,0,0,16" />

                    <StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Background="{StaticResource AccentPrimary}"
                                    CornerRadius="10"
                                    Width="22" Height="22"
                                    Margin="0,0,12,0">
                                <TextBlock Text="1"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock TextWrapping="Wrap" MaxWidth="700">
                                <Run Foreground="{StaticResource TextSecondary}"
                                     FontFamily="{StaticResource FontUI}"
                                     FontSize="{StaticResource FontSizeBody}">Log in to your router's admin panel. Common addresses: </Run>
                                <Run Foreground="{StaticResource AccentCyan}"
                                     FontFamily="{StaticResource FontMono}"
                                     FontSize="{StaticResource FontSizeBody}">192.168.1.1</Run>
                                <Run Foreground="{StaticResource TextSecondary}"
                                     FontFamily="{StaticResource FontUI}"
                                     FontSize="{StaticResource FontSizeBody}"> or </Run>
                                <Run Foreground="{StaticResource AccentCyan}"
                                     FontFamily="{StaticResource FontMono}"
                                     FontSize="{StaticResource FontSizeBody}">192.168.0.1</Run>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Background="{StaticResource AccentPrimary}"
                                    CornerRadius="10"
                                    Width="22" Height="22"
                                    Margin="0,0,12,0">
                                <TextBlock Text="2"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Find the Port Forwarding section (sometimes under Advanced, NAT, or Firewall)."
                                       Foreground="{StaticResource TextSecondary}"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       TextWrapping="Wrap"
                                       MaxWidth="700" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Background="{StaticResource AccentPrimary}"
                                    CornerRadius="10"
                                    Width="22" Height="22"
                                    Margin="0,0,12,0">
                                <TextBlock Text="3"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock TextWrapping="Wrap" MaxWidth="700">
                                <Run Foreground="{StaticResource TextSecondary}"
                                     FontFamily="{StaticResource FontUI}"
                                     FontSize="{StaticResource FontSizeBody}">Create a rule for each port listed above. Set the internal (LAN) IP to your Host LAN IP (</Run>
                                <Run Text="{Binding HostIp}"
                                     Foreground="{StaticResource AccentCyan}"
                                     FontFamily="{StaticResource FontMono}"
                                     FontSize="{StaticResource FontSizeBody}" />
                                <Run Foreground="{StaticResource TextSecondary}"
                                     FontFamily="{StaticResource FontUI}"
                                     FontSize="{StaticResource FontSizeBody}">) and set the protocol to UDP.</Run>
                            </TextBlock>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Border Background="{StaticResource AccentPrimary}"
                                    CornerRadius="10"
                                    Width="22" Height="22"
                                    Margin="0,0,12,0">
                                <TextBlock Text="4"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Save the rules and restart your router if prompted."
                                       Foreground="{StaticResource TextSecondary}"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       TextWrapping="Wrap"
                                       MaxWidth="700" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Border Background="{StaticResource AccentPrimary}"
                                    CornerRadius="10"
                                    Width="22" Height="22"
                                    Margin="0,0,12,0">
                                <TextBlock Text="5"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontWeight="Bold"
                                           FontSize="12"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock TextWrapping="Wrap" MaxWidth="700">
                                <Run Foreground="{StaticResource TextSecondary}"
                                     FontFamily="{StaticResource FontUI}"
                                     FontSize="{StaticResource FontSizeBody}">Share your </Run>
                                <Run Foreground="{StaticResource TextPrimary}"
                                     FontFamily="{StaticResource FontUI}"
                                     FontSize="{StaticResource FontSizeBody}"
                                     FontWeight="SemiBold">public IP address</Run>
                                <Run Foreground="{StaticResource TextSecondary}"
                                     FontFamily="{StaticResource FontUI}"
                                     FontSize="{StaticResource FontSizeBody}"> with players. Find it at whatismyip.com — this is different from the LAN IP shown above.</Run>
                            </TextBlock>
                        </StackPanel>

                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- CARD 5 — Local Connectivity Check (#89)               -->
            <!-- ══════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,16" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="LOCAL PORT CHECK"
                                       Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Text="Tests whether each port has a process listening locally. Start the battlegroup first."
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="12"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding TestConnectivityCommand}"
                                IsEnabled="{Binding IsLoading, Converter={StaticResource BoolInverseConverter}}"
                                Style="{StaticResource TealButtonStyle}"
                                VerticalAlignment="Center">
                            <TextBlock Text="Run Check" />
                        </Button>
                    </Grid>

                    <!-- Results (shown after test) -->
                    <StackPanel Visibility="{Binding ConnectivityTested, Converter={StaticResource BoolToVisibleConverter}}">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PORT"   Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Grid.Column="1" Text="PROTO"  Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Grid.Column="2" Text="NAME"   Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Grid.Column="3" Text="STATUS" Style="{StaticResource SectionLabelStyle}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ConnectivityResults}" />
                        <TextBlock Text="This check tests local port listening only. It does not verify external internet reachability."
                                   Foreground="{StaticResource TextMuted}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="12"
                                   Margin="0,10,0,0" />
                    </StackPanel>

                    <!-- Pre-test placeholder -->
                    <TextBlock Text="Click Run Check after starting your battlegroup."
                               Foreground="{StaticResource TextMuted}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeBody}"
                               Visibility="{Binding ConnectivityTested, Converter={StaticResource BoolToCollapsedConverter}}" />
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════ -->
            <!-- CARD 6 — Connection Summary (#90)                     -->
            <!-- ══════════════════════════════════════════════════════ -->
            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,24" Padding="20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="CONNECTION SUMMARY"
                                       Style="{StaticResource SectionLabelStyle}" />
                            <TextBlock Text="Share this with players so they can connect to your battlegroup."
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="12"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding CopyConnectionSummaryCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                VerticalAlignment="Center">
                            <TextBlock Text="Copy to Clipboard" />
                        </Button>
                    </Grid>

                    <Border Background="{StaticResource DeepBackground}"
                            BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerMedium}"
                            Padding="14">
                        <TextBox Text="{Binding ConnectionSummary, Mode=OneWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="{StaticResource TextSecondary}"
                                 FontFamily="{StaticResource FontMono}"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 TextWrapping="NoWrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Disabled" />
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
