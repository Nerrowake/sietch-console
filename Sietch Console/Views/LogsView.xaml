<UserControl x:Class="Sietch_Console.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <StackPanel Grid.Row="0" Margin="28,24,28,16">
            <TextBlock Style="{StaticResource PageTitleStyle}"
                       Text="Logs"
                       Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="View and search live battlegroup log output. Detected issues appear above the log stream." />
        </StackPanel>

        <!-- ═══════════════════════════════════════ -->
        <!-- Toolbar                                 -->
        <!-- ═══════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderDefault}"
                BorderThickness="0,1,0,1"
                Padding="28,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search box -->
                <Border Grid.Column="0"
                        Background="{StaticResource FieldBackground}"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerMedium}"
                        Height="34">
                    <Grid Margin="10,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="🔍"
                                   Foreground="{StaticResource TextDisabled}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <TextBlock Grid.Column="1"
                                   Text="Search logs..."
                                   Foreground="{StaticResource TextDisabled}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <!-- Severity filters -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Border Background="#2A1E12"
                            BorderBrush="{StaticResource AccentPrimary}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerMedium}"
                            Padding="14,0" Height="34" Margin="0,0,4,0">
                        <TextBlock Text="All"
                                   Foreground="{StaticResource AccentPrimary}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="12" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Background="{StaticResource FieldBackground}"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerMedium}"
                            Padding="14,0" Height="34" Margin="0,0,4,0">
                        <TextBlock Text="Error"
                                   Foreground="{StaticResource StatusError}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Background="{StaticResource FieldBackground}"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerMedium}"
                            Padding="14,0" Height="34" Margin="0,0,4,0">
                        <TextBlock Text="Warning"
                                   Foreground="{StaticResource StatusWarning}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Background="{StaticResource FieldBackground}"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerMedium}"
                            Padding="14,0" Height="34">
                        <TextBlock Text="Info"
                                   Foreground="{StaticResource StatusInfo}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <!-- Action buttons -->
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Border Background="{StaticResource FieldBackground}"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerMedium}"
                            Padding="14,0" Height="34"
                            Margin="0,0,8,0" Opacity="0.5">
                        <TextBlock Text="Copy"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Background="{StaticResource FieldBackground}"
                            BorderBrush="{StaticResource BorderDefault}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource CornerMedium}"
                            Padding="14,0" Height="34" Opacity="0.5">
                        <TextBlock Text="Export"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════ -->
        <!-- Detected Issues Bar                     -->
        <!-- ═══════════════════════════════════════ -->
        <Border Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Margin="28,16,28,0"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8"
                             Fill="{StaticResource StatusOffline}"
                             VerticalAlignment="Center"
                             Margin="0,0,10,0" />
                    <TextBlock Text="Detected Issues"
                               Foreground="{StaticResource TextPrimary}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="No issues detected. Start your battlegroup to begin streaming logs."
                           Foreground="{StaticResource TextMuted}"
                           FontFamily="{StaticResource FontUI}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0" />

                <TextBlock Grid.Column="2"
                           Text="0 issues"
                           Foreground="{StaticResource TextDisabled}"
                           FontFamily="{StaticResource FontUI}"
                           FontSize="12"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════ -->
        <!-- Log Stream                              -->
        <!-- ═══════════════════════════════════════ -->
        <Border Grid.Row="3"
                Margin="28,12,28,20"
                Background="{StaticResource DeepBackground}"
                BorderBrush="{StaticResource BorderDefault}"
                BorderThickness="1"
                CornerRadius="{StaticResource CornerLarge}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Stream header -->
                <Border Grid.Row="0"
                        Background="{StaticResource SurfaceBackground}"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="0,0,0,1"
                        CornerRadius="8,8,0,0"
                        Padding="16,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Style="{StaticResource SectionLabelStyle}"
                                   Text="LOG OUTPUT"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Ellipse Width="7" Height="7"
                                     Fill="{StaticResource StatusOffline}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,6,0" />
                            <TextBlock Text="Not streaming"
                                       Foreground="{StaticResource TextDisabled}"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="{StaticResource FontSizeSmall}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Log content -->
                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              Padding="16">
                    <StackPanel>
                        <StackPanel HorizontalAlignment="Center"
                                    Margin="0,60">
                            <TextBlock Text="No log output available."
                                       Foreground="{StaticResource TextDisabled}"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8" />
                            <TextBlock Text="Start your battlegroup to begin streaming live log data."
                                       Foreground="{StaticResource TextDisabled}"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="12"
                                       HorizontalAlignment="Center"
                                       Opacity="0.6" />
                        </StackPanel>

                        <!-- Sample format preview -->
                        <StackPanel Opacity="0.3">
                            <TextBlock FontFamily="{StaticResource FontMono}"
                                       FontSize="12" Margin="0,0,0,3">
                                <Run Foreground="{StaticResource TextDisabled}" Text="[00:00:00] " />
                                <Run Foreground="{StaticResource StatusInfo}"    Text="INFO  " />
                                <Run Foreground="{StaticResource TextMuted}"     Text="Server initializing..." />
                            </TextBlock>
                            <TextBlock FontFamily="{StaticResource FontMono}"
                                       FontSize="12" Margin="0,0,0,3">
                                <Run Foreground="{StaticResource TextDisabled}" Text="[00:00:01] " />
                                <Run Foreground="{StaticResource StatusWarning}" Text="WARN  " />
                                <Run Foreground="{StaticResource TextMuted}"     Text="Waiting for cluster readiness..." />
                            </TextBlock>
                            <TextBlock FontFamily="{StaticResource FontMono}"
                                       FontSize="12">
                                <Run Foreground="{StaticResource TextDisabled}" Text="[00:00:02] " />
                                <Run Foreground="{StaticResource StatusError}"  Text="ERROR " />
                                <Run Foreground="{StaticResource TextMuted}"    Text="Connection refused on port 7777" />
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
