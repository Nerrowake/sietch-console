<UserControl x:Class="Sietch_Console.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SietchConsole.Core.Models;assembly=SietchConsole.Core"
             Background="{StaticResource AppBackground}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24,28,28">

                <!-- Page Header -->
                <TextBlock Style="{StaticResource PageTitleStyle}"
                           Text="Backups"
                           Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="Create and restore battlegroup configuration and save data backups."
                           Margin="0,0,0,16" />

                <!-- Loading bar while backup operation runs -->
                <ProgressBar Style="{StaticResource LoadingBarStyle}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibleConverter}}"
                             Margin="0,0,0,16" />

                <!-- Status message -->
                <Border Background="{StaticResource StatusSuccessBg}"
                        BorderBrush="{StaticResource StatusSuccessBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerMedium}"
                        Padding="14,10"
                        Margin="0,0,0,14"
                        Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource StatusSuccess}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeBody}" />
                </Border>

                <!-- Action bar -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="20,14"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitleStyle}"
                                       Text="Create Backup"
                                       Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource MutedTextStyle}"
                                       Text="A timestamped backup is stored in %LOCALAPPDATA%\SietchConsole\Backups." />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- Backup Config -->
                            <Button Command="{Binding BackupConfigCommand}"
                                    Style="{StaticResource InfoButtonStyle}"
                                    Margin="0,0,8,0"
                                    Padding="16,8"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource BoolInverseConverter}}">
                                <TextBlock Text="Backup Config" />
                            </Button>

                            <!-- Backup Save Data -->
                            <Button Command="{Binding BackupSaveDataCommand}"
                                    Style="{StaticResource SuccessButtonStyle}"
                                    Margin="0,0,8,0"
                                    Padding="16,8"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource BoolInverseConverter}}">
                                <TextBlock Text="Backup Save Data" />
                            </Button>

                            <!-- Full Backup (#135) -->
                            <Button Command="{Binding BackupFullCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="16,8"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource BoolInverseConverter}}">
                                <TextBlock Text="Full Backup" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Auto-backup settings (#136, #138) ── -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="20,16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}"
                                   Text="Automatic Backups"
                                   Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                   Text="Schedule a full backup at regular intervals. Older backups are pruned automatically."
                                   Margin="0,0,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Enable toggle -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding AutoBackupEnabled}"
                                          Foreground="{StaticResource TextPrimary}"
                                          FontFamily="{StaticResource FontUI}"
                                          FontSize="{StaticResource FontSizeBody}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                                <TextBlock Text="Enable automatic backups"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Interval picker -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Every"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{Binding IntervalChoices}"
                                          SelectedItem="{Binding BackupIntervalHours}"
                                          Width="70"
                                          IsEnabled="{Binding AutoBackupEnabled}"
                                          Background="{StaticResource FieldBackground}"
                                          Foreground="{StaticResource TextPrimary}"
                                          FontFamily="{StaticResource FontUI}"
                                          FontSize="{StaticResource FontSizeBody}" />
                                <TextBlock Text="hours"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </StackPanel>

                            <!-- Retention -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Keep"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <Border Background="{StaticResource FieldBackground}"
                                        BorderBrush="{StaticResource BorderDefault}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource CornerSmall}"
                                        Width="52" Height="30">
                                    <TextBox Text="{Binding BackupRetainCount, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource TextPrimary}"
                                             FontFamily="{StaticResource FontUI}"
                                             FontSize="{StaticResource FontSizeBody}"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="backups"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </StackPanel>

                            <!-- Save button -->
                            <Button Grid.Column="6"
                                    Command="{Binding SaveAutoBackupSettingsCommand}"
                                    Style="{StaticResource TealButtonStyle}"
                                    Padding="16,8">
                                <TextBlock Text="Save" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- #79 – Backup listing -->
                <!-- Empty state -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="20,16"
                        Margin="0,0,0,8"
                        Visibility="{Binding HasBackups, Converter={StaticResource BoolToCollapsedConverter}}">
                    <Border Style="{StaticResource EmptyStateBorderStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource EmptyStateHeadingStyle}"
                                       Text="No backups yet."
                                       Margin="0,0,0,6" />
                            <TextBlock Style="{StaticResource EmptyStateSubtextStyle}"
                                       Text="Use the buttons above to create your first configuration or save data backup."
                                       MaxWidth="420" />
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Backup cards -->
                <ItemsControl ItemsSource="{Binding Backups}"
                              Visibility="{Binding HasBackups, Converter={StaticResource BoolToVisibleConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:BackupRecord}">
                            <Border Style="{StaticResource CardStyle}"
                                    Padding="20,14"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*"    />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Type badge -->
                                    <Border Grid.Column="0"
                                            CornerRadius="{StaticResource CornerSmall}"
                                            Padding="10,4"
                                            Margin="0,0,16,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"  Value="{StaticResource StatusInfoBg}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource StatusInfoBorder}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BackupType}" Value="SaveData">
                                                        <Setter Property="Background"  Value="{StaticResource StatusSuccessBg}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessBorder}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BackupType}" Value="Full">
                                                        <Setter Property="Background"  Value="{StaticResource StatusWarningBg}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource StatusWarningBorder}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontFamily="{StaticResource FontUI}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"       Value="Config" />
                                                    <Setter Property="Foreground" Value="{StaticResource AccentCyan}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BackupType}" Value="SaveData">
                                                            <Setter Property="Text"       Value="Save Data" />
                                                            <Setter Property="Foreground" Value="{StaticResource StatusSuccess}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding BackupType}" Value="Full">
                                                            <Setter Property="Text"       Value="Full" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentPrimary}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Metadata -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Foreground="{StaticResource TextPrimary}"
                                                   FontFamily="{StaticResource FontUI}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding CreatedAt, StringFormat='yyyy-MM-dd  HH:mm:ss'}"
                                                   Margin="0,0,0,2" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource MutedTextStyle}"
                                                       Text="{Binding SizeBytes, Converter={StaticResource FileSizeConverter}}"
                                                       Margin="0,0,16,0" />
                                            <TextBlock Style="{StaticResource MutedTextStyle}"
                                                       Text="{Binding Notes}"
                                                       Visibility="{Binding Notes, Converter={StaticResource NullToCollapsedConverter}}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <!-- Restore -->
                                        <Button Command="{Binding DataContext.RequestRestoreCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource CancelButtonStyle}"
                                                Margin="0,0,6,0"
                                                Padding="12,6">
                                            <TextBlock Text="Restore" />
                                        </Button>

                                        <!-- Delete -->
                                        <Button Command="{Binding DataContext.RequestDeleteCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Padding="12,6">
                                            <TextBlock Text="Delete" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Confirmation overlay (#80, #81) ── -->
        <Grid Background="#BB0B0F14"
              Visibility="{Binding ShowConfirmation, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerLarge}"
                    Padding="28,24"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding ConfirmationTitle}"
                               Foreground="{StaticResource TextPrimary}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeSubheading}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ConfirmationBody}"
                               Foreground="{StaticResource TextSecondary}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeBody}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CancelActionCommand}"
                                Style="{StaticResource CancelButtonStyle}"
                                Margin="0,0,8,0"
                                Padding="16,8">
                            <TextBlock Text="Cancel" />
                        </Button>
                        <Button Command="{Binding ConfirmActionCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Padding="16,8">
                            <TextBlock Text="Confirm" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
