<UserControl x:Class="Sietch_Console.Views.BackupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SietchConsole.Core.Models;assembly=SietchConsole.Core"
             xmlns:cloudmodels="clr-namespace:SietchConsole.Core.Models;assembly=SietchConsole.Core"
             Background="{StaticResource AppBackground}">

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24,28,28">

                <!-- Page Header -->
                <TextBlock Style="{StaticResource PageTitleStyle}"
                           Text="Backups"
                           Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="Create and restore battlegroup configuration and save data backups."
                           Margin="0,0,0,16" />

                <!-- Loading bar while backup operation runs -->
                <ProgressBar Style="{StaticResource LoadingBarStyle}"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibleConverter}}"
                             Margin="0,0,0,16" />

                <!-- Status message -->
                <Border Background="{StaticResource StatusSuccessBg}"
                        BorderBrush="{StaticResource StatusSuccessBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerMedium}"
                        Padding="14,10"
                        Margin="0,0,0,14"
                        Visibility="{Binding StatusMessage, Converter={StaticResource NullToCollapsedConverter}}">
                    <TextBlock Text="{Binding StatusMessage}"
                               Foreground="{StaticResource StatusSuccess}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeBody}" />
                </Border>

                <!-- Action bar -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="20,14"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource CardTitleStyle}"
                                       Text="Create Backup"
                                       Margin="0,0,0,4" />
                            <TextBlock Style="{StaticResource MutedTextStyle}"
                                       Text="A timestamped backup is stored in %LOCALAPPDATA%\SietchConsole\Backups." />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- Backup Config -->
                            <Button Command="{Binding BackupConfigCommand}"
                                    Style="{StaticResource InfoButtonStyle}"
                                    Margin="0,0,8,0"
                                    Padding="16,8"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource BoolInverseConverter}}">
                                <TextBlock Text="Backup Config" />
                            </Button>

                            <!-- Backup Save Data -->
                            <Button Command="{Binding BackupSaveDataCommand}"
                                    Style="{StaticResource SuccessButtonStyle}"
                                    Margin="0,0,8,0"
                                    Padding="16,8"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource BoolInverseConverter}}">
                                <TextBlock Text="Backup Save Data" />
                            </Button>

                            <!-- Full Backup (#135) -->
                            <Button Command="{Binding BackupFullCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="16,8"
                                    IsEnabled="{Binding IsLoading, Converter={StaticResource BoolInverseConverter}}">
                                <TextBlock Text="Full Backup" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── Auto-backup settings (#136, #138) ── -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="20,16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}"
                                   Text="Automatic Backups"
                                   Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                   Text="Schedule a full backup at regular intervals. Older backups are pruned automatically."
                                   Margin="0,0,0,14" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Enable toggle -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding AutoBackupEnabled}"
                                          Foreground="{StaticResource TextPrimary}"
                                          FontFamily="{StaticResource FontUI}"
                                          FontSize="{StaticResource FontSizeBody}"
                                          VerticalAlignment="Center"
                                          Margin="0,0,8,0" />
                                <TextBlock Text="Enable automatic backups"
                                           Foreground="{StaticResource TextPrimary}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Interval picker -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Every"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <ComboBox ItemsSource="{Binding IntervalChoices}"
                                          SelectedItem="{Binding BackupIntervalHours}"
                                          Width="70"
                                          IsEnabled="{Binding AutoBackupEnabled}"
                                          Background="{StaticResource FieldBackground}"
                                          Foreground="{StaticResource TextPrimary}"
                                          FontFamily="{StaticResource FontUI}"
                                          FontSize="{StaticResource FontSizeBody}" />
                                <TextBlock Text="hours"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </StackPanel>

                            <!-- Retention -->
                            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Keep"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />
                                <Border Background="{StaticResource FieldBackground}"
                                        BorderBrush="{StaticResource BorderDefault}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource CornerSmall}"
                                        Width="52" Height="30">
                                    <TextBox Text="{Binding BackupRetainCount, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{StaticResource TextPrimary}"
                                             FontFamily="{StaticResource FontUI}"
                                             FontSize="{StaticResource FontSizeBody}"
                                             VerticalAlignment="Center"
                                             HorizontalAlignment="Center" />
                                </Border>
                                <TextBlock Text="backups"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0" />
                            </StackPanel>

                            <!-- Save button -->
                            <Button Grid.Column="6"
                                    Command="{Binding SaveAutoBackupSettingsCommand}"
                                    Style="{StaticResource TealButtonStyle}"
                                    Padding="16,8">
                                <TextBlock Text="Save" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- #79 – Backup listing -->
                <!-- Empty state -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="20,16"
                        Margin="0,0,0,8"
                        Visibility="{Binding HasBackups, Converter={StaticResource BoolToCollapsedConverter}}">
                    <Border Style="{StaticResource EmptyStateBorderStyle}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource EmptyStateHeadingStyle}"
                                       Text="No backups yet."
                                       Margin="0,0,0,6" />
                            <TextBlock Style="{StaticResource EmptyStateSubtextStyle}"
                                       Text="Use the buttons above to create your first configuration or save data backup."
                                       MaxWidth="420" />
                        </StackPanel>
                    </Border>
                </Border>

                <!-- Backup cards -->
                <ItemsControl ItemsSource="{Binding Backups}"
                              Visibility="{Binding HasBackups, Converter={StaticResource BoolToVisibleConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:BackupRecord}">
                            <Border Style="{StaticResource CardStyle}"
                                    Padding="20,14"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*"    />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Type badge -->
                                    <Border Grid.Column="0"
                                            CornerRadius="{StaticResource CornerSmall}"
                                            Padding="10,4"
                                            Margin="0,0,16,0"
                                            VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background"  Value="{StaticResource StatusInfoBg}" />
                                                <Setter Property="BorderBrush" Value="{StaticResource StatusInfoBorder}" />
                                                <Setter Property="BorderThickness" Value="1" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding BackupType}" Value="SaveData">
                                                        <Setter Property="Background"  Value="{StaticResource StatusSuccessBg}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessBorder}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BackupType}" Value="Full">
                                                        <Setter Property="Background"  Value="{StaticResource StatusWarningBg}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource StatusWarningBorder}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding BackupType}" Value="VM">
                                                        <Setter Property="Background"  Value="{StaticResource StatusWarningBg}" />
                                                        <Setter Property="BorderBrush" Value="{StaticResource StatusWarningBorder}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontFamily="{StaticResource FontUI}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text"       Value="Config" />
                                                    <Setter Property="Foreground" Value="{StaticResource AccentCyan}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BackupType}" Value="SaveData">
                                                            <Setter Property="Text"       Value="Save Data" />
                                                            <Setter Property="Foreground" Value="{StaticResource StatusSuccess}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding BackupType}" Value="Full">
                                                            <Setter Property="Text"       Value="Full" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentPrimary}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding BackupType}" Value="VM">
                                                            <Setter Property="Text"       Value="VM" />
                                                            <Setter Property="Foreground" Value="{StaticResource AccentAmber}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Metadata -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Foreground="{StaticResource TextPrimary}"
                                                   FontFamily="{StaticResource FontUI}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding CreatedAt, StringFormat='yyyy-MM-dd  HH:mm:ss'}"
                                                   Margin="0,0,0,2" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource MutedTextStyle}"
                                                       Text="{Binding SizeBytes, Converter={StaticResource FileSizeConverter}}"
                                                       Margin="0,0,16,0" />
                                            <TextBlock Style="{StaticResource MutedTextStyle}"
                                                       Text="{Binding Notes}"
                                                       Visibility="{Binding Notes, Converter={StaticResource NullToCollapsedConverter}}" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Actions -->
                                    <StackPanel Grid.Column="2"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <!-- Cloud sync indicator / Sync button -->
                                        <Border CornerRadius="{StaticResource CornerSmall}"
                                                Padding="8,4"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding CloudSyncedAt, Converter={StaticResource NullToCollapsedConverter}}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background"    Value="{StaticResource StatusSuccessBg}" />
                                                    <Setter Property="BorderBrush"   Value="{StaticResource StatusSuccessBorder}" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="☁ Synced"
                                                       Foreground="{StaticResource StatusSuccess}"
                                                       FontFamily="{StaticResource FontUI}"
                                                       FontSize="11" />
                                        </Border>

                                        <!-- Sync to Cloud -->
                                        <Button Command="{Binding DataContext.SyncToCloudCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource InfoButtonStyle}"
                                                Margin="0,0,6,0"
                                                Padding="12,6">
                                            <TextBlock Text="↑ Sync" />
                                        </Button>

                                        <!-- Restore -->
                                        <Button Command="{Binding DataContext.RequestRestoreCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource CancelButtonStyle}"
                                                Margin="0,0,6,0"
                                                Padding="12,6">
                                            <TextBlock Text="Restore" />
                                        </Button>

                                        <!-- Delete -->
                                        <Button Command="{Binding DataContext.RequestDeleteCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButtonStyle}"
                                                Padding="12,6">
                                            <TextBlock Text="Delete" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ══════════════════════════════════════════════════════ -->
                <!-- VM Backup — battlegroup backup/import (#199, #200)   -->
                <!-- ══════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="20,16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource CardTitleStyle}"
                                           Text="VM Backup"
                                           Margin="0,0,0,2" />
                                <TextBlock Style="{StaticResource MutedTextStyle}"
                                           TextWrapping="Wrap"
                                           Text="Run battlegroup backup inside the VM to create a server-managed archive. Use Restore on a VM backup entry to run battlegroup import." />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding VmBackupCommand}"
                                    IsEnabled="{Binding IsVmBackupBusy, Converter={StaticResource BoolInverseConverter}}"
                                    Style="{StaticResource TealButtonStyle}"
                                    Padding="16,8"
                                    VerticalAlignment="Top">
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="VM Backup" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsVmBackupBusy}" Value="True">
                                                    <Setter Property="Text" Value="Running…" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button>
                        </Grid>

                        <!-- Loading strip -->
                        <ProgressBar Style="{StaticResource LoadingBarStyle}"
                                     Visibility="{Binding IsVmBackupBusy, Converter={StaticResource BoolToVisibleConverter}}"
                                     Margin="0,10,0,0" />

                        <!-- Live output log -->
                        <Border Background="{StaticResource SurfaceBackground}"
                                BorderBrush="{StaticResource BorderDefault}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerSmall}"
                                Padding="12,10"
                                Margin="0,10,0,0"
                                Visibility="{Binding VmBackupLog, Converter={StaticResource NullToCollapsedConverter}}">
                            <TextBox Text="{Binding VmBackupLog, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextSecondary}"
                                     FontFamily="{StaticResource FontMono}"
                                     FontSize="11"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     MaxHeight="160" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ══════════════════════════════════════════════════════ -->
                <!-- Cloud Sync Configuration (#174, #175, #176)          -->
                <!-- ══════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="20,16"
                        Margin="0,16,0,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}"
                                   Text="Cloud Sync"
                                   Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   Text="Automatically upload backups to OneDrive or an S3-compatible service (AWS, Backblaze B2, Cloudflare R2, MinIO)."
                                   Margin="0,0,0,14" />

                        <!-- Loading bar -->
                        <ProgressBar Style="{StaticResource LoadingBarStyle}"
                                     Visibility="{Binding CloudIsBusy, Converter={StaticResource BoolToVisibleConverter}}"
                                     Margin="0,0,0,10" />

                        <!-- Progress bar for uploads/downloads -->
                        <ProgressBar Value="{Binding CloudProgress}"
                                     Minimum="0" Maximum="1"
                                     Height="4"
                                     Margin="0,0,0,10"
                                     Foreground="{StaticResource AccentPrimary}"
                                     Background="{StaticResource SurfaceBackground}"
                                     BorderThickness="0"
                                     Visibility="{Binding CloudIsBusy, Converter={StaticResource BoolToVisibleConverter}}" />

                        <!-- Enable + Provider row -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Style="{StaticResource BodyTextStyle}"
                                       Text="Provider" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding CloudProviders}"
                                      SelectedItem="{Binding CloudProvider}"
                                      MinWidth="120"
                                      Background="{StaticResource FieldBackground}"
                                      Foreground="{StaticResource TextPrimary}"
                                      FontFamily="{StaticResource FontUI}"
                                      FontSize="{StaticResource FontSizeBody}" />
                            <CheckBox Grid.Column="3"
                                      IsChecked="{Binding CloudEnabled}"
                                      Foreground="{StaticResource TextSecondary}"
                                      FontFamily="{StaticResource FontUI}"
                                      FontSize="{StaticResource FontSizeBody}"
                                      Content="Enable sync"
                                      VerticalAlignment="Center" />
                        </Grid>

                        <!-- Remote folder (shared for both providers) -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource BodyTextStyle}" Text="Remote Folder / Prefix" />
                                <TextBlock Style="{StaticResource MutedTextStyle}" Text="e.g. SietchConsole/Backups" />
                            </StackPanel>
                            <TextBox Grid.Column="1"
                                     Text="{Binding CloudFolderPath, UpdateSourceTrigger=PropertyChanged}"
                                     Background="{StaticResource FieldBackground}"
                                     Foreground="{StaticResource TextPrimary}"
                                     BorderBrush="{StaticResource BorderDefault}"
                                     BorderThickness="1"
                                     FontFamily="{StaticResource FontMono}"
                                     FontSize="12"
                                     Padding="8,6"
                                     CaretBrush="{StaticResource AccentPrimary}" />
                        </Grid>

                        <!-- ── OneDrive fields (#175) ── -->
                        <StackPanel Visibility="{Binding ShowOneDriveFields, Converter={StaticResource BoolToVisibleConverter}}">
                            <Border Background="{StaticResource StatusInfoBg}"
                                    BorderBrush="{StaticResource StatusInfoBorder}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CornerMedium}"
                                    Padding="12,10"
                                    Margin="0,0,0,12">
                                <TextBlock Foreground="{StaticResource AccentCyan}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           TextWrapping="Wrap"
                                           Text="OneDrive uses your personal Microsoft account. Click Test to sign in — a browser window will open for authentication. Your token is cached locally with DPAPI encryption." />
                            </Border>
                        </StackPanel>

                        <!-- ── S3 fields (#176) ── -->
                        <StackPanel Visibility="{Binding ShowS3Fields, Converter={StaticResource BoolToVisibleConverter}}">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="Endpoint URL" />
                                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="Leave blank for AWS" />
                                </StackPanel>
                                <TextBox Grid.Column="1"
                                         Text="{Binding S3Endpoint, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource FieldBackground}"
                                         Foreground="{StaticResource TextPrimary}"
                                         BorderBrush="{StaticResource BorderDefault}"
                                         BorderThickness="1"
                                         FontFamily="{StaticResource FontMono}"
                                         FontSize="12"
                                         Padding="8,6"
                                         CaretBrush="{StaticResource AccentPrimary}" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource BodyTextStyle}"
                                           Text="Bucket" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding S3Bucket, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource FieldBackground}"
                                         Foreground="{StaticResource TextPrimary}"
                                         BorderBrush="{StaticResource BorderDefault}"
                                         BorderThickness="1"
                                         FontFamily="{StaticResource FontMono}"
                                         FontSize="12"
                                         Padding="8,6"
                                         CaretBrush="{StaticResource AccentPrimary}" />
                                <TextBlock Grid.Column="2" />
                                <TextBox Grid.Column="3"
                                         Text="{Binding S3Region, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource FieldBackground}"
                                         Foreground="{StaticResource TextPrimary}"
                                         BorderBrush="{StaticResource BorderDefault}"
                                         BorderThickness="1"
                                         FontFamily="{StaticResource FontMono}"
                                         FontSize="12"
                                         Padding="8,6"
                                         CaretBrush="{StaticResource AccentPrimary}" />
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Style="{StaticResource BodyTextStyle}"
                                           Text="Access Key ID" VerticalAlignment="Center" />
                                <TextBox Grid.Column="1"
                                         Text="{Binding S3AccessKeyId, UpdateSourceTrigger=PropertyChanged}"
                                         Background="{StaticResource FieldBackground}"
                                         Foreground="{StaticResource TextPrimary}"
                                         BorderBrush="{StaticResource BorderDefault}"
                                         BorderThickness="1"
                                         FontFamily="{StaticResource FontMono}"
                                         FontSize="12"
                                         Padding="8,6"
                                         CaretBrush="{StaticResource AccentPrimary}" />
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Style="{StaticResource BodyTextStyle}" Text="Secret Key" />
                                    <TextBlock Style="{StaticResource MutedTextStyle}" Text="Stored encrypted (DPAPI)" />
                                </StackPanel>
                                <PasswordBox Grid.Column="1"
                                             PasswordChanged="S3SecretKeyBox_PasswordChanged"
                                             Background="{StaticResource FieldBackground}"
                                             Foreground="{StaticResource TextPrimary}"
                                             BorderBrush="{StaticResource BorderDefault}"
                                             BorderThickness="1"
                                             FontFamily="{StaticResource FontMono}"
                                             FontSize="12"
                                             Padding="8,6" />
                            </Grid>
                        </StackPanel>

                        <!-- Status message -->
                        <TextBlock Text="{Binding CloudStatusMessage}"
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,10"
                                   Visibility="{Binding CloudStatusMessage, Converter={StaticResource NullToCollapsedConverter}}" />

                        <!-- Action buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding TestCloudConnectionCommand}"
                                    IsEnabled="{Binding CloudIsBusy, Converter={StaticResource BoolInverseConverter}}"
                                    Style="{StaticResource InfoButtonStyle}"
                                    Padding="14,7"
                                    Margin="0,0,8,0"
                                    Content="Test Connection" />
                            <Button Command="{Binding SaveCloudSettingsCommand}"
                                    IsEnabled="{Binding CloudIsBusy, Converter={StaticResource BoolInverseConverter}}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="14,7"
                                    Content="Save Settings" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ══════════════════════════════════════════════════════ -->
                <!-- Cloud Backup List — restore from cloud (#173)         -->
                <!-- ══════════════════════════════════════════════════════ -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="20,16"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Style="{StaticResource CardTitleStyle}"
                                           Text="Cloud Backups"
                                           Margin="0,0,0,2" />
                                <TextBlock Style="{StaticResource MutedTextStyle}"
                                           Text="Backups stored in the configured remote location." />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding RefreshCloudBackupsCommand}"
                                    IsEnabled="{Binding CloudIsBusy, Converter={StaticResource BoolInverseConverter}}"
                                    Style="{StaticResource TealButtonStyle}"
                                    Padding="12,6"
                                    VerticalAlignment="Top"
                                    Content="Refresh" />
                        </Grid>

                        <!-- Empty state -->
                        <Border Style="{StaticResource EmptyStateBorderStyle}"
                                Visibility="{Binding HasCloudBackups, Converter={StaticResource BoolToCollapsedConverter}}">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource EmptyStateHeadingStyle}"
                                           Text="No cloud backups found."
                                           Margin="0,0,0,6" />
                                <TextBlock Style="{StaticResource EmptyStateSubtextStyle}"
                                           Text="Click Refresh after configuring a provider, or use ↑ Sync to upload a local backup."
                                           MaxWidth="420" />
                            </StackPanel>
                        </Border>

                        <!-- Cloud backup rows -->
                        <ItemsControl ItemsSource="{Binding CloudBackups}"
                                      Visibility="{Binding HasCloudBackups, Converter={StaticResource BoolToVisibleConverter}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type cloudmodels:CloudBackupFile}">
                                    <Border Background="{StaticResource SurfaceBackground}"
                                            BorderBrush="{StaticResource BorderDefault}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource CornerSmall}"
                                            Padding="14,10"
                                            Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Foreground="{StaticResource TextPrimary}"
                                                           FontFamily="{StaticResource FontMono}"
                                                           FontSize="12"
                                                           Text="{Binding FileName}"
                                                           Margin="0,0,0,2" />
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource MutedTextStyle}"
                                                               Text="{Binding SizeBytes, Converter={StaticResource FileSizeConverter}}"
                                                               Margin="0,0,16,0" />
                                                    <TextBlock Style="{StaticResource MutedTextStyle}"
                                                               Text="{Binding CreatedAt, StringFormat='yyyy-MM-dd  HH:mm:ss'}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Download and Restore -->
                                                <Button Command="{Binding DataContext.DownloadAndRestoreCloudBackupCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource CancelButtonStyle}"
                                                        Margin="0,0,6,0"
                                                        Padding="12,6">
                                                    <TextBlock Text="↓ Restore" />
                                                </Button>
                                                <!-- Delete from cloud -->
                                                <Button Command="{Binding DataContext.DeleteCloudBackupCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource DangerButtonStyle}"
                                                        Padding="12,6">
                                                    <TextBlock Text="Delete" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ── Confirmation overlay (#80, #81) ── -->
        <Grid Background="#BB0B0F14"
              Visibility="{Binding ShowConfirmation, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerLarge}"
                    Padding="28,24"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding ConfirmationTitle}"
                               Foreground="{StaticResource TextPrimary}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeSubheading}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ConfirmationBody}"
                               Foreground="{StaticResource TextSecondary}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeBody}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CancelActionCommand}"
                                Style="{StaticResource CancelButtonStyle}"
                                Margin="0,0,8,0"
                                Padding="16,8">
                            <TextBlock Text="Cancel" />
                        </Button>
                        <Button Command="{Binding ConfirmActionCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Padding="16,8">
                            <TextBlock Text="Confirm" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
