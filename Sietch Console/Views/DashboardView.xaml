<UserControl x:Class="Sietch_Console.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackground}">

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="28,24,28,28">

            <!-- Page Header -->
            <TextBlock Style="{StaticResource PageTitleStyle}"
                       Text="Dashboard"
                       Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource PageSubtitleStyle}"
                       Text="Overview of your battlegroup, system health, and recent activity."
                       Margin="0,0,0,24" />

            <!-- ═══════════════════════════════════════ -->
            <!-- Status Cards Row                        -->
            <!-- ═══════════════════════════════════════ -->
            <UniformGrid Rows="1" Columns="3" Margin="0,0,0,16">

                <!-- Battlegroup Status -->
                <Border Style="{StaticResource CardStyle}"
                        Margin="0,0,8,0"
                        Padding="20,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabelStyle}"
                                   Text="BATTLEGROUP"
                                   Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="10" Height="10"
                                     Fill="{StaticResource StatusOffline}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0" />
                            <TextBlock Text="Offline"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="{StaticResource FontSizeHeading}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                   Text="No active battlegroup detected." />
                    </StackPanel>
                </Border>

                <!-- VM Status -->
                <Border Style="{StaticResource CardStyle}"
                        Margin="4,0"
                        Padding="20,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabelStyle}"
                                   Text="VIRTUAL MACHINE"
                                   Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="10" Height="10"
                                     Fill="{StaticResource StatusOffline}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0" />
                            <TextBlock Text="Not Running"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="{StaticResource FontSizeHeading}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                   Text="Hyper-V VM is stopped." />
                    </StackPanel>
                </Border>

                <!-- System Health -->
                <Border Style="{StaticResource CardStyle}"
                        Margin="8,0,0,0"
                        Padding="20,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabelStyle}"
                                   Text="SYSTEM HEALTH"
                                   Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="10" Height="10"
                                     Fill="{StaticResource StatusOffline}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0" />
                            <TextBlock Text="Not Checked"
                                       Foreground="{StaticResource TextPrimary}"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="{StaticResource FontSizeHeading}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                   Text="Run diagnostics to verify readiness." />
                    </StackPanel>
                </Border>

            </UniformGrid>

            <!-- ═══════════════════════════════════════ -->
            <!-- Middle Row: Quick Actions + Diagnostics -->
            <!-- ═══════════════════════════════════════ -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Quick Actions -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}"
                        Padding="20,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}"
                                   Text="Quick Actions"
                                   Margin="0,0,0,16" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="{StaticResource StatusSuccessBg}"
                                    BorderBrush="{StaticResource StatusSuccessBorder}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CornerMedium}"
                                    Height="40" Opacity="0.5">
                                <TextBlock Text="Start Battlegroup"
                                           Foreground="{StaticResource StatusSuccess}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="2"
                                    Background="{StaticResource StatusErrorBg}"
                                    BorderBrush="{StaticResource StatusErrorBorder}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CornerMedium}"
                                    Height="40" Opacity="0.5">
                                <TextBlock Text="Stop Battlegroup"
                                           Foreground="{StaticResource StatusError}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Background="{StaticResource StatusInfoBg}"
                                    BorderBrush="{StaticResource StatusInfoBorder}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource CornerMedium}"
                                    Height="40" Opacity="0.5">
                                <TextBlock Text="Restart"
                                           Foreground="{StaticResource AccentCyan}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Border Grid.Column="2"
                                    Style="{StaticResource CardStyle}"
                                    CornerRadius="{StaticResource CornerMedium}"
                                    Height="40" Opacity="0.5">
                                <TextBlock Text="Open Logs"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                   Text="Actions are unavailable until a battlegroup is configured."
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <!-- Recent Diagnostics -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}"
                        Padding="20,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}"
                                   Text="Recent Diagnostics"
                                   Margin="0,0,0,16" />
                        <Border Background="{StaticResource FieldBackground}"
                                BorderBrush="{StaticResource BorderDefault}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerMedium}"
                                Padding="16">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="No diagnostics have been run."
                                           Foreground="{StaticResource TextMuted}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           HorizontalAlignment="Center"
                                           Margin="0,0,0,6" />
                                <TextBlock Text="Use the Diagnostics section to check system readiness."
                                           Foreground="{StaticResource TextDisabled}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           HorizontalAlignment="Center"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══════════════════════════════════════ -->
            <!-- Bottom Row: Last Backup + Networking    -->
            <!-- ═══════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Last Backup -->
                <Border Grid.Column="0"
                        Style="{StaticResource CardStyle}"
                        Padding="20,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}"
                                   Text="Last Backup"
                                   Margin="0,0,0,16" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <Ellipse Width="8" Height="8"
                                     Fill="{StaticResource StatusOffline}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,8,0" />
                            <TextBlock Text="No backups found"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="{StaticResource FontSizeBody}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource MutedTextStyle}"
                                   Text="Create a backup from the Backups section before making configuration changes."
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Networking -->
                <Border Grid.Column="2"
                        Style="{StaticResource CardStyle}"
                        Padding="20,16">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}"
                                   Text="Networking"
                                   Margin="0,0,0,16" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Host LAN IP"
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="12"
                                       Margin="0,0,16,0" />
                            <TextBlock Grid.Column="1"
                                       Text="—"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="12" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="VM IP"
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="12"
                                       Margin="0,0,16,0" />
                            <TextBlock Grid.Column="1"
                                       Text="—"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="12" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Required Ports"
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="12"
                                       Margin="0,0,16,0" />
                            <TextBlock Grid.Column="1"
                                       Text="7777–7810 UDP, 31982 TCP"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="12" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>
