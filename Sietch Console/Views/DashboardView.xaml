<UserControl x:Class="Sietch_Console.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SietchConsole.Core.Models;assembly=SietchConsole.Core"
             Background="{StaticResource AppBackground}">

    <Grid>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- Main scrollable content                         -->
        <!-- ═══════════════════════════════════════════════ -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24,28,28">

                <!-- Page Header -->
                <TextBlock Style="{StaticResource PageTitleStyle}"
                           Text="Dashboard"
                           Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="Overview of your battlegroup, system health, and recent activity."
                           Margin="0,0,0,16" />

                <!-- #94 — Loading bar while transitioning -->
                <ProgressBar Style="{StaticResource LoadingBarStyle}"
                             Visibility="{Binding IsTransitioning, Converter={StaticResource BoolToVisibleConverter}}"
                             Margin="0,0,0,16" />

                <!-- Update available banner -->
                <Border Background="{StaticResource AccentCyan}"
                        CornerRadius="{StaticResource CornerSmall}"
                        Visibility="{Binding HasUpdateAvailable, Converter={StaticResource BoolToVisibleConverter}}"
                        Padding="16,10"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding UpdateBannerText}"
                                   Foreground="#0B0F14"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                            <Button Command="{Binding CheckForUpdatesCommand}"
                                    Style="{StaticResource CancelButtonStyle}"
                                    Padding="10,4"
                                    Margin="0,0,8,0"
                                    ToolTip="Re-check Steam for a newer server version"
                                    AutomationProperties.Name="Re-check for updates">
                                <TextBlock Text="Re-check" />
                            </Button>
                            <Button Command="{Binding RequestUpdateCommand}"
                                    Style="{StaticResource TealButtonStyle}"
                                    Padding="10,4"
                                    ToolTip="Stop the server, apply the update, and restart"
                                    AutomationProperties.Name="Update server">
                                <TextBlock Text="Update Now" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Error banner — shown when a Hyper-V operation fails -->
                <Border Background="{StaticResource AccentAmber}"
                        CornerRadius="{StaticResource CornerSmall}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibleConverter}}"
                        Padding="16,10"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding LastError}"
                                   Foreground="#0B0F14"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Command="{Binding DismissErrorCommand}"
                                Style="{StaticResource CancelButtonStyle}"
                                Padding="10,4"
                                Margin="12,0,0,0"
                                ToolTip="Dismiss this error"
                                AutomationProperties.Name="Dismiss error">
                            <TextBlock Text="Dismiss" />
                        </Button>
                    </Grid>
                </Border>

                <!-- ══════════════════════════════════════════ -->
                <!-- Battlegroup Status + Controls Card         -->
                <!-- ══════════════════════════════════════════ -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="20,16"
                        Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Left: Identity + Status -->
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionLabelStyle}"
                                       Text="BATTLEGROUP"
                                       Margin="0,0,0,8" />

                            <TextBlock Foreground="{StaticResource TextPrimary}"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="{StaticResource FontSizeHeading}"
                                       FontWeight="SemiBold"
                                       Text="{Binding ProfileName}"
                                       Margin="0,0,0,6" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource MutedTextStyle}"
                                           Text="VM: "
                                           Margin="0,0,4,0" />
                                <TextBlock Style="{StaticResource MutedTextStyle}"
                                           Text="{Binding VmName}" />
                            </StackPanel>

                            <!-- Live status dot + text -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse Width="10" Height="10"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource StatusOffline}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:BattlegroupRuntimeStatus.Running}">
                                                    <Setter Property="Fill" Value="{StaticResource StatusSuccess}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:BattlegroupRuntimeStatus.Starting}">
                                                    <Setter Property="Fill" Value="{StaticResource StatusRunning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:BattlegroupRuntimeStatus.Stopping}">
                                                    <Setter Property="Fill" Value="{StaticResource StatusWarning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:BattlegroupRuntimeStatus.Error}">
                                                    <Setter Property="Fill" Value="{StaticResource StatusError}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Foreground="{StaticResource TextSecondary}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           Text="{Binding StatusText}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <!-- Resource utilization — visible only while Running with data -->
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding HasResourceData, Converter={StaticResource BoolToVisibleConverter}}">
                                <TextBlock Style="{StaticResource MutedTextStyle}"
                                           Text="CPU"
                                           Margin="0,0,4,0" />
                                <TextBlock Foreground="{StaticResource TextSecondary}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           Text="{Binding CpuPercent, StringFormat={}{0}%}"
                                           Margin="0,0,16,0" />
                                <TextBlock Style="{StaticResource MutedTextStyle}"
                                           Text="RAM"
                                           Margin="0,0,4,0" />
                                <TextBlock Foreground="{StaticResource TextSecondary}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="{StaticResource FontSizeBody}"
                                           Text="{Binding MemoryGbText}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- #92 — Action buttons using theme styles -->
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center"
                                    Margin="16,0,0,0">

                            <Button Command="{Binding StartCommand}"
                                    Style="{StaticResource SuccessButtonStyle}"
                                    Padding="16,8"
                                    Margin="0,0,8,0"
                                    ToolTip="Start the battlegroup server"
                                    AutomationProperties.Name="Start battlegroup">
                                <TextBlock Text="Start" />
                            </Button>

                            <Button Command="{Binding RequestStopCommand}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Padding="16,8"
                                    Margin="0,0,8,0"
                                    ToolTip="Stop the battlegroup server and disconnect all players"
                                    AutomationProperties.Name="Stop battlegroup">
                                <TextBlock Text="Stop" />
                            </Button>

                            <Button Command="{Binding RequestRestartCommand}"
                                    Style="{StaticResource InfoButtonStyle}"
                                    Padding="16,8"
                                    Margin="0,0,8,0"
                                    ToolTip="Restart the battlegroup — briefly disconnects all players"
                                    AutomationProperties.Name="Restart battlegroup">
                                <TextBlock Text="Restart" />
                            </Button>

                            <Button Command="{Binding CheckForUpdatesCommand}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Padding="12,8"
                                    Margin="0,0,8,0"
                                    ToolTip="Check Steam for a newer server version"
                                    AutomationProperties.Name="Check for updates">
                                <TextBlock Text="Check for Updates" />
                            </Button>

                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Update-in-progress panel -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="20,16"
                        Margin="0,0,0,16"
                        Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibleConverter}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitleStyle}"
                                   Text="Updating Server"
                                   Margin="0,0,0,12" />
                        <ProgressBar Minimum="0" Maximum="100"
                                     Value="{Binding UpdateProgress}"
                                     Height="6"
                                     Margin="0,0,0,12">
                            <ProgressBar.Style>
                                <Style TargetType="ProgressBar" BasedOn="{StaticResource LoadingBarStyle}">
                                    <Setter Property="IsIndeterminate" Value="False" />
                                </Style>
                            </ProgressBar.Style>
                        </ProgressBar>
                        <ScrollViewer MaxHeight="120"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Text="{Binding UpdateLog}"
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- ══════════════════════════════════════════ -->
                <!-- Middle Row: Access Shortcuts + Diagnostics -->
                <!-- ══════════════════════════════════════════ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- #92, #96 — Access Shortcuts with tooltips -->
                    <Border Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            Padding="20,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleStyle}"
                                       Text="Access Shortcuts"
                                       Margin="0,0,0,16" />

                            <Button Command="{Binding OpenControlInterfaceCommand}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Stretch"
                                    Padding="12,9"
                                    ToolTip="Open the Hyper-V VM web admin panel in your browser"
                                    AutomationProperties.Name="Open control interface">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Control Interface"
                                               Foreground="{StaticResource AccentPrimary}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="— Web admin panel"
                                               Foreground="{StaticResource TextMuted}" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding OpenFileBrowserCommand}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    Margin="0,0,0,8"
                                    HorizontalAlignment="Stretch"
                                    Padding="12,9"
                                    ToolTip="Open the battlegroup install directory in Windows Explorer"
                                    AutomationProperties.Name="Open file browser">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="File Browser"
                                               Foreground="{StaticResource AccentCyan}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="— Open install directory"
                                               Foreground="{StaticResource TextMuted}" />
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding OpenVmShellCommand}"
                                    Style="{StaticResource GhostButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Padding="12,9"
                                    ToolTip="Open a shell session in the Hyper-V virtual machine"
                                    AutomationProperties.Name="Open VM shell">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="VM Shell"
                                               Foreground="{StaticResource AccentViolet}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="— Hyper-V console"
                                               Foreground="{StaticResource TextMuted}" />
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </Border>

                    <!-- Recent Diagnostics — #93 standardised empty state -->
                    <Border Grid.Column="2"
                            Style="{StaticResource CardStyle}"
                            Padding="20,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleStyle}"
                                       Text="Recent Diagnostics"
                                       Margin="0,0,0,16" />
                            <Border Style="{StaticResource EmptyStateBorderStyle}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Style="{StaticResource EmptyStateHeadingStyle}"
                                               Text="No diagnostics have been run."
                                               Margin="0,0,0,6" />
                                    <TextBlock Style="{StaticResource EmptyStateSubtextStyle}"
                                               Text="Use the Diagnostics section to check system readiness." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ══════════════════════════════════════════ -->
                <!-- Bottom Row: Last Backup + Networking       -->
                <!-- ══════════════════════════════════════════ -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Last Backup — #93 standardised empty state -->
                    <Border Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            Padding="20,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleStyle}"
                                       Text="Last Backup"
                                       Margin="0,0,0,16" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse Width="8" Height="8"
                                         Fill="{StaticResource StatusOffline}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0" />
                                <TextBlock Text="No backups found"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="{StaticResource FontSizeBody}" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource MutedTextStyle}"
                                       Text="Create a backup from the Backups section before making configuration changes."
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!-- Networking summary -->
                    <Border Grid.Column="2"
                            Style="{StaticResource CardStyle}"
                            Padding="20,16">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitleStyle}"
                                       Text="Networking"
                                       Margin="0,0,0,16" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Host LAN IP"
                                           Foreground="{StaticResource TextMuted}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="12"
                                           Margin="0,0,16,0" />
                                <TextBlock Grid.Column="1"
                                           Text="—"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="12" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="VM IP"
                                           Foreground="{StaticResource TextMuted}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="12"
                                           Margin="0,0,16,0" />
                                <TextBlock Grid.Column="1"
                                           Text="—"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="12" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Required Ports"
                                           Foreground="{StaticResource TextMuted}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="12"
                                           Margin="0,0,16,0" />
                                <TextBlock Grid.Column="1"
                                           Text="7777–7778 UDP, 27015–27016 UDP"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- Confirmation overlay — #92, #95 refined styling -->
        <!-- ═══════════════════════════════════════════════ -->
        <Grid Background="#BB0B0F14"
              Visibility="{Binding ShowConfirmation, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerLarge}"
                    Padding="28,24"
                    MaxWidth="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding ConfirmationTitle}"
                               Foreground="{StaticResource TextPrimary}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeSubheading}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ConfirmationBody}"
                               Foreground="{StaticResource TextSecondary}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeBody}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CancelActionCommand}"
                                Style="{StaticResource CancelButtonStyle}"
                                Padding="16,8"
                                Margin="0,0,8,0"
                                ToolTip="Cancel and return to Dashboard"
                                AutomationProperties.Name="Cancel action">
                            <TextBlock Text="Cancel" />
                        </Button>
                        <Button Command="{Binding ConfirmActionCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Padding="16,8"
                                ToolTip="Confirm this action"
                                AutomationProperties.Name="Confirm action">
                            <TextBlock Text="Confirm" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
