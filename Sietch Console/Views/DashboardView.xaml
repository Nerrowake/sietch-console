<UserControl x:Class="Sietch_Console.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:SietchConsole.Core.Models;assembly=SietchConsole.Core"
             Background="{StaticResource AppBackground}">

    <Grid>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,24,28,28">

                <!-- ── Page Header ── -->
                <TextBlock Style="{StaticResource PageTitleStyle}"
                           Text="Dashboard"
                           Margin="0,0,0,4" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="Monitor and control your battlegroup server."
                           Margin="0,0,0,20" />

                <!-- ── Transition loading strip ── -->
                <ProgressBar Style="{StaticResource LoadingBarStyle}"
                             Visibility="{Binding IsTransitioning, Converter={StaticResource BoolToVisibleConverter}}"
                             Margin="0,0,0,16" />

                <!-- ── Error banner ── -->
                <Border Style="{StaticResource ErrorBannerStyle}"
                        Margin="0,0,0,16"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibleConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding LastError}"
                                   Foreground="{StaticResource StatusError}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="{StaticResource FontSizeBody}"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Command="{Binding DismissErrorCommand}"
                                Style="{StaticResource CancelButtonStyle}"
                                Padding="10,4"
                                Margin="12,0,0,0"
                                Content="Dismiss" />
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════════════ -->
                <!-- HERO: Battlegroup Status + Controls                 -->
                <!-- ═══════════════════════════════════════════════════ -->
                <Border Margin="0,0,0,12"
                        ClipToBounds="True"
                        CornerRadius="{StaticResource CornerLarge}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background"      Value="{StaticResource CardBackground}" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="BorderBrush"     Value="{StaticResource BorderSubtle}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:BattlegroupRuntimeStatus.Running}">
                                    <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessBorder}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:BattlegroupRuntimeStatus.Starting}">
                                    <Setter Property="BorderBrush" Value="{StaticResource StatusWarningBorder}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:BattlegroupRuntimeStatus.Stopping}">
                                    <Setter Property="BorderBrush" Value="{StaticResource StatusWarningBorder}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Status}" Value="{x:Static models:BattlegroupRuntimeStatus.Error}">
                                    <Setter Property="BorderBrush" Value="{StaticResource StatusErrorBorder}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <Grid>
                        <!-- Status accent stripe (left edge, 3 px wide) -->
                        <Border Width="3" HorizontalAlignment="Left" VerticalAlignment="Stretch">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource BorderDefault}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:BattlegroupRuntimeStatus.Running}">
                                            <Setter Property="Background" Value="{StaticResource StatusSuccess}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:BattlegroupRuntimeStatus.Starting}">
                                            <Setter Property="Background" Value="{StaticResource AccentAmber}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:BattlegroupRuntimeStatus.Stopping}">
                                            <Setter Property="Background" Value="{StaticResource AccentAmber}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="{x:Static models:BattlegroupRuntimeStatus.Error}">
                                            <Setter Property="Background" Value="{StaticResource StatusError}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>

                        <!-- Hero content -->
                        <Grid Margin="24,22,22,22">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left: Identity + Status + Resources -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">

                                <!-- Section label -->
                                <TextBlock Text="BATTLEGROUP"
                                           Style="{StaticResource SectionLabelStyle}"
                                           Margin="0,0,0,8" />

                                <!-- Server name -->
                                <TextBlock Text="{Binding ProfileName}"
                                           Foreground="{StaticResource AccentSandstone}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="{StaticResource FontSizeDisplay}"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,4" />

                                <!-- VM name -->
                                <TextBlock Text="{Binding VmName, StringFormat={}vm: {0}}"
                                           Foreground="{StaticResource TextMuted}"
                                           FontFamily="{StaticResource FontMono}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           Margin="0,0,0,12" />

                                <!-- Status dot + text -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8"
                                             VerticalAlignment="Center"
                                             Margin="0,0,8,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource StatusOffline}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:BattlegroupRuntimeStatus.Running}">
                                                        <Setter Property="Fill" Value="{StaticResource StatusSuccess}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:BattlegroupRuntimeStatus.Starting}">
                                                        <Setter Property="Fill" Value="{StaticResource AccentAmber}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:BattlegroupRuntimeStatus.Stopping}">
                                                        <Setter Property="Fill" Value="{StaticResource AccentAmber}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="{x:Static models:BattlegroupRuntimeStatus.Error}">
                                                        <Setter Property="Fill" Value="{StaticResource StatusError}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock Text="{Binding StatusText}"
                                               Foreground="{StaticResource TextSecondary}"
                                               FontFamily="{StaticResource FontUI}"
                                               FontSize="{StaticResource FontSizeBody}"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                    <!-- Uptime (only when running) -->
                                    <TextBlock Text="{Binding UptimeText, StringFormat={} — {0}}"
                                               Foreground="{StaticResource TextMuted}"
                                               FontFamily="{StaticResource FontUI}"
                                               FontSize="{StaticResource FontSizeBody}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,0,0"
                                               Visibility="{Binding UptimeText, Converter={StaticResource NullToCollapsedConverter}}" />
                                </StackPanel>

                                <!-- Resource meters (Running + data available) -->
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,8,0,0"
                                            Visibility="{Binding HasResourceData, Converter={StaticResource BoolToVisibleConverter}}">
                                    <Border Background="{StaticResource FieldBackground}"
                                            BorderBrush="{StaticResource BorderDefault}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource CornerSmall}"
                                            Padding="8,4"
                                            Margin="0,0,8,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="CPU"
                                                       Style="{StaticResource SectionLabelStyle}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding CpuPercent, StringFormat={}{0}%}"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontFamily="{StaticResource FontMono}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{StaticResource FieldBackground}"
                                            BorderBrush="{StaticResource BorderDefault}"
                                            BorderThickness="1"
                                            CornerRadius="{StaticResource CornerSmall}"
                                            Padding="8,4">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="RAM"
                                                       Style="{StaticResource SectionLabelStyle}"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding MemoryGbText}"
                                                       Foreground="{StaticResource TextPrimary}"
                                                       FontFamily="{StaticResource FontMono}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Right: Contextual action buttons -->
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Margin="24,0,0,0"
                                        MinWidth="120">

                                <!-- Start (offline / error) -->
                                <Button Command="{Binding StartCommand}"
                                        Style="{StaticResource SuccessButtonStyle}"
                                        Padding="20,10"
                                        HorizontalAlignment="Stretch"
                                        Visibility="{Binding IsStopped, Converter={StaticResource BoolToVisibleConverter}}"
                                        Content="Start" />

                                <!-- Stop / Restart / Update (running) -->
                                <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibleConverter}}">
                                    <Button Command="{Binding RequestStopCommand}"
                                            Style="{StaticResource DangerButtonStyle}"
                                            Padding="20,10"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,0,8"
                                            Content="Stop" />
                                    <Button Command="{Binding RequestRestartCommand}"
                                            Style="{StaticResource InfoButtonStyle}"
                                            Padding="20,10"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,0,0,8"
                                            Content="Restart" />
                                    <Button Command="{Binding RequestUpdateCommand}"
                                            Style="{StaticResource GhostButtonStyle}"
                                            Padding="20,9"
                                            HorizontalAlignment="Stretch"
                                            Content="Update" />
                                </StackPanel>

                                <!-- No profile state -->
                                <TextBlock Text="No battlegroup configured."
                                           Style="{StaticResource MutedTextStyle}"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center"
                                           MaxWidth="140"
                                           Visibility="{Binding HasProfile, Converter={StaticResource BoolToCollapsedConverter}}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ═══════════════════════════════════════════════════ -->
                <!-- QUICK ACTION TILES (3-up)                           -->
                <!-- ═══════════════════════════════════════════════════ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Control Interface tile -->
                    <Button Grid.Column="0"
                            Command="{Binding OpenControlInterfaceCommand}"
                            HorizontalAlignment="Stretch"
                            Cursor="Hand"
                            ToolTip="Open the Battlegroup Director web UI"
                            AutomationProperties.Name="Open control interface">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="TileBd"
                                        Background="{StaticResource CardBackground}"
                                        BorderBrush="{StaticResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource CornerLarge}"
                                        Padding="16,14">
                                    <StackPanel>
                                        <Border Height="2" Background="{StaticResource AccentPrimary}"
                                                CornerRadius="1" Margin="0,0,0,10" HorizontalAlignment="Left" Width="28" />
                                        <TextBlock Text="Control Interface"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontFamily="{StaticResource FontUI}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,3" />
                                        <TextBlock Text="Battlegroup Director"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontFamily="{StaticResource FontUI}"
                                                   FontSize="{StaticResource FontSizeSmall}" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TileBd" Property="Background" Value="{StaticResource OverlayBackground}" />
                                        <Setter TargetName="TileBd" Property="BorderBrush" Value="{StaticResource BorderWarm}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- File Browser tile -->
                    <Button Grid.Column="2"
                            Command="{Binding OpenFileBrowserCommand}"
                            HorizontalAlignment="Stretch"
                            Cursor="Hand"
                            ToolTip="Open the in-VM file browser at port 18888"
                            AutomationProperties.Name="Open file browser">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="TileBd"
                                        Background="{StaticResource CardBackground}"
                                        BorderBrush="{StaticResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource CornerLarge}"
                                        Padding="16,14">
                                    <StackPanel>
                                        <Border Height="2" Background="{StaticResource AccentCyan}"
                                                CornerRadius="1" Margin="0,0,0,10" HorizontalAlignment="Left" Width="28" />
                                        <TextBlock Text="File Browser"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontFamily="{StaticResource FontUI}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,3" />
                                        <TextBlock Text="In-VM file manager"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontFamily="{StaticResource FontUI}"
                                                   FontSize="{StaticResource FontSizeSmall}" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TileBd" Property="Background" Value="{StaticResource OverlayBackground}" />
                                        <Setter TargetName="TileBd" Property="BorderBrush" Value="{StaticResource BorderWarm}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- VM Shell tile -->
                    <Button Grid.Column="4"
                            Command="{Binding OpenVmShellCommand}"
                            HorizontalAlignment="Stretch"
                            Cursor="Hand"
                            ToolTip="Open a Hyper-V console session to the VM"
                            AutomationProperties.Name="Open VM shell">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="TileBd"
                                        Background="{StaticResource CardBackground}"
                                        BorderBrush="{StaticResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource CornerLarge}"
                                        Padding="16,14">
                                    <StackPanel>
                                        <Border Height="2" Background="{StaticResource AccentViolet}"
                                                CornerRadius="1" Margin="0,0,0,10" HorizontalAlignment="Left" Width="28" />
                                        <TextBlock Text="VM Shell"
                                                   Foreground="{StaticResource TextPrimary}"
                                                   FontFamily="{StaticResource FontUI}"
                                                   FontSize="{StaticResource FontSizeBody}"
                                                   FontWeight="SemiBold"
                                                   Margin="0,0,0,3" />
                                        <TextBlock Text="Hyper-V console"
                                                   Foreground="{StaticResource TextMuted}"
                                                   FontFamily="{StaticResource FontUI}"
                                                   FontSize="{StaticResource FontSizeSmall}" />
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TileBd" Property="Background" Value="{StaticResource OverlayBackground}" />
                                        <Setter TargetName="TileBd" Property="BorderBrush" Value="{StaticResource BorderWarm}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ═══════════════════════════════════════════════════ -->
                <!-- INFO ROW: Networking + Last Backup                  -->
                <!-- ═══════════════════════════════════════════════════ -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Networking -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="Networking"
                                       Style="{StaticResource CardTitleStyle}"
                                       Margin="0,0,0,14" />

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="VM IP"
                                           Style="{StaticResource SectionLabelStyle}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding VmIpText}"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontFamily="{StaticResource FontMono}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Game Ports"
                                           Style="{StaticResource SectionLabelStyle}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="7777–7810 UDP"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontFamily="{StaticResource FontMono}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="RabbitMQ"
                                           Style="{StaticResource SectionLabelStyle}"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="31982 TCP"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontFamily="{StaticResource FontMono}"
                                           FontSize="{StaticResource FontSizeSmall}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Last Backup -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20,16">
                        <StackPanel>
                            <TextBlock Text="Last Backup"
                                       Style="{StaticResource CardTitleStyle}"
                                       Margin="0,0,0,14" />

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <Ellipse Width="7" Height="7"
                                         Fill="{StaticResource StatusOffline}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0" />
                                <TextBlock Text="No backups on record"
                                           Foreground="{StaticResource TextSecondary}"
                                           FontFamily="{StaticResource FontUI}"
                                           FontSize="{StaticResource FontSizeBody}" />
                            </StackPanel>

                            <TextBlock Text="Create a backup before making configuration changes."
                                       Style="{StaticResource MutedTextStyle}"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ═══════════════════════════════════════════════════ -->
                <!-- Update in-progress panel                            -->
                <!-- ═══════════════════════════════════════════════════ -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="20,16"
                        Margin="0,0,0,16"
                        Visibility="{Binding IsUpdating, Converter={StaticResource BoolToVisibleConverter}}">
                    <StackPanel>
                        <TextBlock Text="Updating Battlegroup"
                                   Style="{StaticResource CardTitleStyle}"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="SteamCMD is running inside the VM. Do not close the application."
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,0,0,12" />
                        <ProgressBar Style="{StaticResource LoadingBarStyle}"
                                     Margin="0,0,0,12" />
                        <ScrollViewer MaxHeight="120"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <TextBlock Text="{Binding UpdateLog}"
                                       Foreground="{StaticResource TextMuted}"
                                       FontFamily="{StaticResource FontMono}"
                                       FontSize="11"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════ -->
                <!-- ADVANCED OPERATIONS (collapsible)                   -->
                <!-- ═══════════════════════════════════════════════════ -->
                <Border Style="{StaticResource CardStyle}"
                        Padding="0"
                        Margin="0,0,0,16">
                    <StackPanel>
                        <!-- Toggle header -->
                        <Button Command="{Binding ToggleAdvancedCommand}"
                                HorizontalAlignment="Stretch"
                                Cursor="Hand"
                                Padding="20,14">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="AdvHdr"
                                            Background="Transparent"
                                            Padding="{TemplateBinding Padding}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="Advanced Operations"
                                                       Foreground="{StaticResource TextSecondary}"
                                                       FontFamily="{StaticResource FontUI}"
                                                       FontSize="{StaticResource FontSizeBody}"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Foreground="{StaticResource TextMuted}"
                                                       FontFamily="{StaticResource FontUI}"
                                                       FontSize="{StaticResource FontSizeSmall}"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="▶  Show" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAdvancedExpanded}" Value="True">
                                                                <Setter Property="Text" Value="▼  Hide" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="AdvHdr" Property="Background" Value="{StaticResource OverlayBackground}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Expandable content -->
                        <StackPanel Visibility="{Binding IsAdvancedExpanded, Converter={StaticResource BoolToVisibleConverter}}">
                            <!-- Divider -->
                            <Border Height="1" Background="{StaticResource BorderSubtle}" Margin="20,0" />

                            <!-- Enable Experimental Swap -->
                            <Grid Margin="20,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="Enable Experimental Swap Memory"
                                               Foreground="{StaticResource TextPrimary}"
                                               FontFamily="{StaticResource FontUI}"
                                               FontSize="{StaticResource FontSizeBody}"
                                               FontWeight="SemiBold"
                                               Margin="0,0,0,4" />
                                    <TextBlock Text="Allows the VM to use disk swap when physical RAM is under 20 GB. The battlegroup must be stopped before enabling. Start it again to apply."
                                               Style="{StaticResource MutedTextStyle}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding SwapStatusMessage}"
                                               Foreground="{StaticResource AccentCyan}"
                                               FontFamily="{StaticResource FontUI}"
                                               FontSize="{StaticResource FontSizeSmall}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding SwapStatusMessage, Converter={StaticResource NullToCollapsedConverter}}" />
                                    <ProgressBar Style="{StaticResource LoadingBarStyle}"
                                                 Margin="0,6,0,0"
                                                 Visibility="{Binding IsEnablingSwap, Converter={StaticResource BoolToVisibleConverter}}" />
                                </StackPanel>

                                <Button Grid.Column="1"
                                        Command="{Binding EnableExperimentalSwapCommand}"
                                        Style="{StaticResource TealButtonStyle}"
                                        Padding="14,8"
                                        VerticalAlignment="Top"
                                        ToolTip="Runs 'battlegroup enable-experimental-swap' inside the VM"
                                        Content="Enable Swap" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ═══════════════════════════════════════════════════ -->
                <!-- Discord Announcement                                 -->
                <!-- ═══════════════════════════════════════════════════ -->
                <Border Style="{StaticResource CardStyle}" Padding="20,16">
                    <StackPanel>
                        <TextBlock Text="Discord Announcement"
                                   Style="{StaticResource CardTitleStyle}"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Send a message to your Discord channel via the configured webhook."
                                   Style="{StaticResource MutedTextStyle}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,12" />

                        <ProgressBar Style="{StaticResource LoadingBarStyle}"
                                     Visibility="{Binding IsAnnouncementBusy, Converter={StaticResource BoolToVisibleConverter}}"
                                     Margin="0,0,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Style="{StaticResource FieldBoxStyle}"
                                     Text="{Binding AnnouncementText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,8,0" />
                            <Button Grid.Column="1"
                                    Command="{Binding SendAnnouncementCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Padding="14,6"
                                    Content="Send" />
                        </Grid>

                        <TextBlock Text="{Binding AnnouncementStatusMessage}"
                                   Style="{StaticResource MutedTextStyle}"
                                   Margin="0,6,0,0"
                                   Visibility="{Binding AnnouncementStatusMessage, Converter={StaticResource NullToCollapsedConverter}}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ═══════════════════════════════════════════════════════ -->
        <!-- Confirmation overlay                                     -->
        <!-- ═══════════════════════════════════════════════════════ -->
        <Grid Background="#CC0B0F14"
              Visibility="{Binding ShowConfirmation, Converter={StaticResource BoolToVisibleConverter}}">
            <Border Background="{StaticResource CardBackground}"
                    BorderBrush="{StaticResource BorderDefault}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource CornerLarge}"
                    Padding="32,28"
                    MaxWidth="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{Binding ConfirmationTitle}"
                               Foreground="{StaticResource AccentSandstone}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeSubheading}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />
                    <TextBlock Text="{Binding ConfirmationBody}"
                               Foreground="{StaticResource TextSecondary}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeBody}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,24" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding CancelActionCommand}"
                                Style="{StaticResource CancelButtonStyle}"
                                Padding="16,8"
                                Margin="0,0,8,0"
                                Content="Cancel" />
                        <Button Command="{Binding ConfirmActionCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Padding="16,8"
                                Content="Confirm" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</UserControl>
