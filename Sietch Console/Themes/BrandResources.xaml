<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- LOGO MARK — Sietch Doorway                                          -->
    <!--                                                                     -->
    <!-- 64×64 design grid. The mark is two mirrored halves separated by a   -->
    <!-- 2 px center gap (the "open vertical split"). Each half has:         -->
    <!--   • angular roof chamfer at the top                                 -->
    <!--   • a side protrusion on the outer wall near mid-height             -->
    <!--   • a dune wave cut into the bottom interior                        -->
    <!-- The whole drawing fills with GoldGradient (defined in SietchTheme). -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- Left half outline -->
    <PathGeometry x:Key="LogoMarkLeftGeometry"
                  Figures="M 8,58 L 8,42 L 3,40 L 3,32 L 8,30 L 8,20 L 12,16 L 16,12 L 20,9 L 30,9 L 30,58 L 24,58 C 21,55 19,55 16,58 L 12,58 C 11,56 10,56 9,58 Z" />

    <!-- Right half outline (mirror) -->
    <PathGeometry x:Key="LogoMarkRightGeometry"
                  Figures="M 56,58 L 56,42 L 61,40 L 61,32 L 56,30 L 56,20 L 52,16 L 48,12 L 44,9 L 34,9 L 34,58 L 40,58 C 43,55 45,55 48,58 L 52,58 C 53,56 54,56 55,58 Z" />

    <!-- Combined geometry — convenient single Path target -->
    <GeometryGroup x:Key="LogoMarkGeometry" FillRule="Nonzero">
        <PathGeometry Figures="M 8,58 L 8,42 L 3,40 L 3,32 L 8,30 L 8,20 L 12,16 L 16,12 L 20,9 L 30,9 L 30,58 L 24,58 C 21,55 19,55 16,58 L 12,58 C 11,56 10,56 9,58 Z" />
        <PathGeometry Figures="M 56,58 L 56,42 L 61,40 L 61,32 L 56,30 L 56,20 L 52,16 L 48,12 L 44,9 L 34,9 L 34,58 L 40,58 C 43,55 45,55 48,58 L 52,58 C 53,56 54,56 55,58 Z" />
    </GeometryGroup>

    <!-- DrawingGroup — gold gradient fill + thin sandstone hairline -->
    <DrawingGroup x:Key="LogoMarkDrawing">
        <GeometryDrawing Brush="{StaticResource GoldGradient}">
            <GeometryDrawing.Pen>
                <Pen Brush="#33000000" Thickness="0.5" />
            </GeometryDrawing.Pen>
            <GeometryDrawing.Geometry>
                <GeometryGroup FillRule="Nonzero">
                    <PathGeometry Figures="M 8,58 L 8,42 L 3,40 L 3,32 L 8,30 L 8,20 L 12,16 L 16,12 L 20,9 L 30,9 L 30,58 L 24,58 C 21,55 19,55 16,58 L 12,58 C 11,56 10,56 9,58 Z" />
                    <PathGeometry Figures="M 56,58 L 56,42 L 61,40 L 61,32 L 56,30 L 56,20 L 52,16 L 48,12 L 44,9 L 34,9 L 34,58 L 40,58 C 43,55 45,55 48,58 L 52,58 C 53,56 54,56 55,58 Z" />
                </GeometryGroup>
            </GeometryDrawing.Geometry>
        </GeometryDrawing>
    </DrawingGroup>

    <!-- DrawingBrush — drop into any Border / Rectangle Background -->
    <DrawingBrush x:Key="LogoMarkBrush"
                  Stretch="Uniform"
                  Drawing="{StaticResource LogoMarkDrawing}" />

    <!-- DrawingImage — drop into <Image Source="{StaticResource LogoMarkImage}" /> -->
    <DrawingImage x:Key="LogoMarkImage"
                  Drawing="{StaticResource LogoMarkDrawing}" />

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- ICON SET — 24×24 grid, 1.5 px stroke, rounded caps                  -->
    <!--                                                                     -->
    <!-- All paths are stroke-only (Brush=null on geometry). Consume via:    -->
    <!--   <Path Data="{StaticResource IconDashboard}"                       -->
    <!--         Stroke="{StaticResource AccentSandstone}"                   -->
    <!--         StrokeThickness="1.5"                                       -->
    <!--         StrokeStartLineCap="Round" StrokeEndLineCap="Round"         -->
    <!--         StrokeLineJoin="Round"                                      -->
    <!--         Width="24" Height="24" Stretch="Uniform" />                 -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <!-- Dashboard — 2×2 tile grid -->
    <PathGeometry x:Key="IconDashboard"
                  Figures="M 4,4 L 10,4 L 10,10 L 4,10 Z M 14,4 L 20,4 L 20,10 L 14,10 Z M 4,14 L 10,14 L 10,20 L 4,20 Z M 14,14 L 20,14 L 20,20 L 14,20 Z" />

    <!-- Battlegroup — three stacked rounded-rect servers -->
    <PathGeometry x:Key="IconBattlegroup"
                  Figures="M 4,5 L 20,5 L 20,9 L 4,9 Z M 4,11 L 20,11 L 20,15 L 4,15 Z M 4,17 L 20,17 L 20,21 L 4,21 Z M 7,7 L 7,7 M 7,13 L 7,13 M 7,19 L 7,19" />

    <!-- Start — play triangle in circle -->
    <PathGeometry x:Key="IconStart"
                  Figures="M 12,3 A 9,9 0 1,0 12,21 A 9,9 0 1,0 12,3 Z M 10,8 L 16,12 L 10,16 Z" />

    <!-- Stop — square in circle -->
    <PathGeometry x:Key="IconStop"
                  Figures="M 12,3 A 9,9 0 1,0 12,21 A 9,9 0 1,0 12,3 Z M 9,9 L 15,9 L 15,15 L 9,15 Z" />

    <!-- Restart — circular arrow with arrowhead -->
    <PathGeometry x:Key="IconRestart"
                  Figures="M 5,12 A 7,7 0 1,1 12,19 M 5,12 L 5,7 M 5,12 L 10,12" />

    <!-- Configuration — gear -->
    <PathGeometry x:Key="IconConfiguration"
                  Figures="M 12,4 L 13,4 L 13.5,6.5 L 15.5,7.3 L 17.5,5.8 L 18.7,7 L 17.2,9 L 18,11 L 20.5,11.5 L 20.5,12.5 L 18,13 L 17.2,15 L 18.7,17 L 17.5,18.2 L 15.5,16.7 L 13.5,17.5 L 13,20 L 12,20 L 11,20 L 10.5,17.5 L 8.5,16.7 L 6.5,18.2 L 5.3,17 L 6.8,15 L 6,13 L 3.5,12.5 L 3.5,11.5 L 6,11 L 6.8,9 L 5.3,7 L 6.5,5.8 L 8.5,7.3 L 10.5,6.5 L 11,4 Z M 12,9 A 3,3 0 1,0 12,15 A 3,3 0 1,0 12,9 Z" />

    <!-- Logs — document with lines -->
    <PathGeometry x:Key="IconLogs"
                  Figures="M 6,3 L 16,3 L 19,6 L 19,21 L 6,21 Z M 16,3 L 16,6 L 19,6 M 9,10 L 16,10 M 9,13 L 16,13 M 9,16 L 14,16" />

    <!-- Diagnostics — heart pulse line -->
    <PathGeometry x:Key="IconDiagnostics"
                  Figures="M 3,12 L 7,12 L 9,7 L 12,17 L 14,10 L 16,12 L 21,12" />

    <!-- Backups — cloud + down arrow -->
    <PathGeometry x:Key="IconBackups"
                  Figures="M 7,17 A 4,4 0 0,1 7,9 A 5,5 0 0,1 17,9 A 3.5,3.5 0 0,1 17,17 Z M 12,11 L 12,17 M 9,14 L 12,17 L 15,14" />

    <!-- Networking — three nodes connected -->
    <PathGeometry x:Key="IconNetworking"
                  Figures="M 5,7 A 1.5,1.5 0 1,0 5,4 A 1.5,1.5 0 1,0 5,7 Z M 19,7 A 1.5,1.5 0 1,0 19,4 A 1.5,1.5 0 1,0 19,7 Z M 12,21 A 1.5,1.5 0 1,0 12,18 A 1.5,1.5 0 1,0 12,21 Z M 5,7 L 12,18 M 19,7 L 12,18 M 5,5.5 L 19,5.5" />

    <!-- Setup Wizard — wand with sparkles -->
    <PathGeometry x:Key="IconSetupWizard"
                  Figures="M 4,20 L 14,10 L 16,12 L 6,22 Z M 17,4 L 17,8 M 15,6 L 19,6 M 21,10 L 21,12 M 20,11 L 22,11 M 13,3 L 13,5 M 12,4 L 14,4" />

    <!-- Settings — sliders -->
    <PathGeometry x:Key="IconSettings"
                  Figures="M 4,7 L 20,7 M 4,12 L 20,12 M 4,17 L 20,17 M 9,7 A 1.5,1.5 0 1,0 9,4 A 1.5,1.5 0 1,0 9,7 Z M 15,12 A 1.5,1.5 0 1,0 15,9 A 1.5,1.5 0 1,0 15,12 Z M 8,17 A 1.5,1.5 0 1,0 8,14 A 1.5,1.5 0 1,0 8,17 Z" />

    <!-- Info — circled i -->
    <PathGeometry x:Key="IconInfo"
                  Figures="M 12,3 A 9,9 0 1,0 12,21 A 9,9 0 1,0 12,3 Z M 12,11 L 12,16 M 12,8 L 12,8" />

    <!-- Warning — triangle with bang -->
    <PathGeometry x:Key="IconWarning"
                  Figures="M 12,3 L 21,20 L 3,20 Z M 12,9 L 12,14 M 12,17 L 12,17" />

    <!-- Error — circled X -->
    <PathGeometry x:Key="IconError"
                  Figures="M 12,3 A 9,9 0 1,0 12,21 A 9,9 0 1,0 12,3 Z M 9,9 L 15,15 M 15,9 L 9,15" />

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- DEFAULT ICON STYLE                                                  -->
    <!-- Shorthand: <Path Data="{StaticResource IconDashboard}"              -->
    <!--                 Style="{StaticResource BrandIconStyle}" />          -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <Style x:Key="BrandIconStyle" TargetType="Path">
        <Setter Property="Stroke"               Value="{StaticResource AccentSandstone}" />
        <Setter Property="StrokeThickness"      Value="1.5" />
        <Setter Property="StrokeStartLineCap"   Value="Round" />
        <Setter Property="StrokeEndLineCap"     Value="Round" />
        <Setter Property="StrokeLineJoin"       Value="Round" />
        <Setter Property="Width"                Value="24" />
        <Setter Property="Height"               Value="24" />
        <Setter Property="Stretch"              Value="Uniform" />
        <Setter Property="SnapsToDevicePixels"  Value="True" />
        <Setter Property="UseLayoutRounding"    Value="True" />
    </Style>

    <Style x:Key="BrandIconAccentStyle" TargetType="Path" BasedOn="{StaticResource BrandIconStyle}">
        <Setter Property="Stroke" Value="{StaticResource AccentPrimary}" />
    </Style>

    <!-- ═══════════════════════════════════════════════════════════════════ -->
    <!-- WORDMARK LOCKUP — small horizontal version for titlebar / footer    -->
    <!-- Composes the mark (DrawingImage) + "SIETCH" / "CONSOLE" stack       -->
    <!-- Use as: <ContentControl Template="{StaticResource AppLockupTemplate}" /> -->
    <!-- ═══════════════════════════════════════════════════════════════════ -->

    <ControlTemplate x:Key="AppLockupTemplate" TargetType="ContentControl">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="{StaticResource LogoMarkImage}"
                   Width="22" Height="22"
                   VerticalAlignment="Center"
                   Margin="0,0,10,0" />
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Sietch"
                           FontFamily="{StaticResource FontUISemibold}"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}"
                           LineHeight="14"
                           Margin="0,0,0,1" />
                <TextBlock Text="CONSOLE"
                           FontFamily="{StaticResource FontUI}"
                           FontSize="8"
                           Foreground="{StaticResource AccentPrimary}"
                           LineHeight="9">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </StackPanel>
    </ControlTemplate>

</ResourceDictionary>
