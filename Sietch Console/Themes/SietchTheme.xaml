<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:converters="clr-namespace:Sietch_Console.Converters">

    <!-- ═══════════════════════════════════════════ -->
    <!-- VALUE CONVERTERS                            -->
    <!-- ═══════════════════════════════════════════ -->

    <converters:NullToCollapsedConverter  x:Key="NullToCollapsedConverter" />
    <converters:BoolToVisibleConverter    x:Key="BoolToVisibleConverter" />
    <converters:BoolToCollapsedConverter  x:Key="BoolToCollapsedConverter" />
    <converters:BoolInverseConverter      x:Key="BoolInverseConverter" />
    <converters:PathToFileNameConverter   x:Key="PathToFileNameConverter" />
    <converters:FileSizeConverter         x:Key="FileSizeConverter" />

    <!-- ═══════════════════════════════════════════ -->
    <!-- BACKGROUND BRUSHES                          -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- Deep Onyx — main window and view backgrounds -->
    <SolidColorBrush x:Key="AppBackground"     Color="#0B0F14" />
    <!-- Charcoal Slate — panels, cards, sidebar -->
    <SolidColorBrush x:Key="PanelBackground"   Color="#141A22" />
    <!-- Panel Dark — inner surfaces, log stream header -->
    <SolidColorBrush x:Key="SurfaceBackground" Color="#111820" />
    <!-- Near-black — log stream body -->
    <SolidColorBrush x:Key="DeepBackground"    Color="#0A0D11" />
    <!-- Dark overlay — input fields, depressed surfaces -->
    <SolidColorBrush x:Key="FieldBackground"   Color="#0F151C" />
    <!-- Subtle blue-dark — hover states, selected overlays -->
    <SolidColorBrush x:Key="OverlayBackground" Color="#1A2030" />
    <!-- Slightly lifted — nav item selected state -->
    <SolidColorBrush x:Key="SelectionBackground" Color="#1F2A36" />
    <!-- Nav item hover -->
    <SolidColorBrush x:Key="HoverBackground"   Color="#191F29" />
    <!-- Card surface — elevated above AppBackground, below PanelBackground -->
    <SolidColorBrush x:Key="CardBackground"    Color="#1A212B" />

    <!-- ═══════════════════════════════════════════ -->
    <!-- BORDER BRUSHES                              -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- Iron Gray — default card and panel borders -->
    <SolidColorBrush x:Key="BorderDefault" Color="#232B35" />
    <!-- Slightly lighter — subtle dividers -->
    <SolidColorBrush x:Key="BorderSubtle"  Color="#26313D" />
    <!-- Ash Brown — warm subtle borders -->
    <SolidColorBrush x:Key="BorderWarm"    Color="#4A3A2A" />

    <!-- ═══════════════════════════════════════════ -->
    <!-- ACCENT BRUSHES                              -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- Spice Orange — primary actions, active states, logo mark -->
    <SolidColorBrush x:Key="AccentPrimary"    Color="#C46A2B" />
    <!-- Sandstone — headings and warm highlights -->
    <SolidColorBrush x:Key="AccentSandstone"  Color="#D6B98C" />
    <!-- Dune Amber — warnings, attention states -->
    <SolidColorBrush x:Key="AccentAmber"      Color="#E0A64B" />
    <!-- Muted Cyan — info, networking, system signals -->
    <SolidColorBrush x:Key="AccentCyan"       Color="#4FB3B8" />
    <!-- Deep Teal — secondary actions -->
    <SolidColorBrush x:Key="AccentTeal"       Color="#1F6F73" />
    <!-- Violet Signal — update/maintenance states -->
    <SolidColorBrush x:Key="AccentViolet"     Color="#8B7CF6" />

    <!-- ═══════════════════════════════════════════ -->
    <!-- TEXT BRUSHES                                -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- Warm near-white — primary readable text -->
    <SolidColorBrush x:Key="TextPrimary"   Color="#F3EBDD" />
    <!-- Warm mid — secondary and body text -->
    <SolidColorBrush x:Key="TextSecondary" Color="#B8AA92" />
    <!-- Muted warm — labels, captions, helper text -->
    <SolidColorBrush x:Key="TextMuted"     Color="#7B6F5D" />
    <!-- Dark gray — disabled and placeholder text -->
    <SolidColorBrush x:Key="TextDisabled"  Color="#4A4F5A" />

    <!-- ═══════════════════════════════════════════ -->
    <!-- STATUS BRUSHES                              -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- Soft Fremen Green — healthy / pass / complete -->
    <SolidColorBrush x:Key="StatusSuccess"  Color="#58B878" />
    <!-- Dune Amber — attention needed / warning -->
    <SolidColorBrush x:Key="StatusWarning"  Color="#E0A64B" />
    <!-- Deep Signal Red — failure / error / blocked -->
    <SolidColorBrush x:Key="StatusError"    Color="#D9534F" />
    <!-- Muted Cyan — informational -->
    <SolidColorBrush x:Key="StatusInfo"     Color="#4FB3B8" />
    <!-- Dust Gray — stopped / offline / unavailable -->
    <SolidColorBrush x:Key="StatusOffline"  Color="#6E747C" />
    <!-- Spice Orange — active / running -->
    <SolidColorBrush x:Key="StatusRunning"  Color="#C46A2B" />
    <!-- Violet Signal — updating / maintenance -->
    <SolidColorBrush x:Key="StatusUpdating" Color="#8B7CF6" />

    <!-- ═══════════════════════════════════════════ -->
    <!-- STATUS BACKGROUND BRUSHES (tinted cards)   -->
    <!-- ═══════════════════════════════════════════ -->

    <SolidColorBrush x:Key="StatusSuccessBg" Color="#1A2A1A" />
    <SolidColorBrush x:Key="StatusSuccessBorder" Color="#2A3D2A" />
    <SolidColorBrush x:Key="StatusWarningBg"  Color="#2A2010" />
    <SolidColorBrush x:Key="StatusWarningBorder" Color="#3D3018" />
    <SolidColorBrush x:Key="StatusErrorBg"   Color="#2A1A1A" />
    <SolidColorBrush x:Key="StatusErrorBorder" Color="#3D2A2A" />
    <SolidColorBrush x:Key="StatusInfoBg"    Color="#1A1F2A" />
    <SolidColorBrush x:Key="StatusInfoBorder" Color="#2A3040" />

    <!-- ═══════════════════════════════════════════ -->
    <!-- TYPOGRAPHY                                  -->
    <!-- ═══════════════════════════════════════════ -->

    <FontFamily x:Key="FontUI">Segoe UI Variable</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Consolas, Courier New</FontFamily>

    <sys:Double x:Key="FontSizeSmall">11</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeSubheading">14</sys:Double>
    <sys:Double x:Key="FontSizeHeading">18</sys:Double>
    <sys:Double x:Key="FontSizeTitle">22</sys:Double>

    <!-- ═══════════════════════════════════════════ -->
    <!-- CORNER RADII                                -->
    <!-- ═══════════════════════════════════════════ -->

    <CornerRadius x:Key="CornerSmall">4</CornerRadius>
    <CornerRadius x:Key="CornerMedium">6</CornerRadius>
    <CornerRadius x:Key="CornerLarge">8</CornerRadius>
    <CornerRadius x:Key="CornerRound">14</CornerRadius>

    <!-- ═══════════════════════════════════════════ -->
    <!-- TEXTBLOCK STYLES                            -->
    <!-- ═══════════════════════════════════════════ -->

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily"  Value="{StaticResource FontUI}" />
        <Setter Property="FontSize"    Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight"  Value="SemiBold" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize"   Value="{StaticResource FontSizeBody}" />
    </Style>

    <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource TextMuted}" />
        <Setter Property="FontFamily"  Value="{StaticResource FontUI}" />
        <Setter Property="FontSize"    Value="10" />
        <Setter Property="FontWeight"  Value="SemiBold" />
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily"  Value="{StaticResource FontUI}" />
        <Setter Property="FontSize"    Value="{StaticResource FontSizeSubheading}" />
        <Setter Property="FontWeight"  Value="SemiBold" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize"   Value="{StaticResource FontSizeBody}" />
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize"   Value="12" />
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!-- BORDER STYLES                               -->
    <!-- ═══════════════════════════════════════════ -->

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource CardBackground}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource CornerLarge}" />
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!-- SIDEBAR NAVIGATION STYLES                   -->
    <!-- ═══════════════════════════════════════════ -->

    <Style x:Key="NavListBoxStyle" TargetType="ListBox">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding"         Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility"   Value="Auto" />
    </Style>

    <!-- #97 — Icon + label, AccentPrimary icon when selected -->
    <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding"  Value="0" />
        <Setter Property="Margin"   Value="8,2" />
        <Setter Property="Cursor"   Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemBorder"
                            Height="40"
                            CornerRadius="{StaticResource CornerSmall}"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="ItemIcon"
                                       Text="{Binding Icon}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{StaticResource TextMuted}"
                                       Width="20"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="12,0,8,0" />
                            <TextBlock x:Name="ItemLabel"
                                       Text="{Binding Label}"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SelectionBackground}" />
                            <Setter TargetName="ItemLabel"  Property="Foreground" Value="{StaticResource TextPrimary}" />
                            <Setter TargetName="ItemIcon"   Property="Foreground" Value="{StaticResource AccentPrimary}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected"  Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverBackground}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!-- BUTTON STYLES (#92, #98)                    -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- Base template — centered content, opacity on hover/disabled -->
    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="Cursor"          Value="Hand" />
        <Setter Property="FontFamily"      Value="{StaticResource FontUI}" />
        <Setter Property="FontSize"        Value="{StaticResource FontSizeBody}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CornerMedium}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Primary — spice orange solid, main CTA -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background"  Value="{StaticResource AccentPrimary}" />
        <Setter Property="Foreground"  Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentPrimary}" />
        <Setter Property="FontWeight"  Value="SemiBold" />
    </Style>

    <!-- Teal — secondary / neutral positive actions -->
    <Style x:Key="TealButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background"  Value="{StaticResource AccentTeal}" />
        <Setter Property="Foreground"  Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentTeal}" />
    </Style>

    <!-- Success — green outline (Start, confirm-positive) -->
    <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background"  Value="{StaticResource StatusSuccessBg}" />
        <Setter Property="Foreground"  Value="{StaticResource StatusSuccess}" />
        <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessBorder}" />
        <Setter Property="FontWeight"  Value="SemiBold" />
    </Style>

    <!-- Danger — red outline (Stop, delete, destructive) -->
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background"  Value="{StaticResource StatusErrorBg}" />
        <Setter Property="Foreground"  Value="{StaticResource StatusError}" />
        <Setter Property="BorderBrush" Value="{StaticResource StatusErrorBorder}" />
        <Setter Property="FontWeight"  Value="SemiBold" />
    </Style>

    <!-- Info — cyan outline (Restart, informational actions) -->
    <Style x:Key="InfoButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background"  Value="{StaticResource StatusInfoBg}" />
        <Setter Property="Foreground"  Value="{StaticResource AccentCyan}" />
        <Setter Property="BorderBrush" Value="{StaticResource StatusInfoBorder}" />
        <Setter Property="FontWeight"  Value="SemiBold" />
    </Style>

    <!-- Ghost — field-colored, left-aligned content, background-change hover -->
    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="Cursor"          Value="Hand" />
        <Setter Property="FontFamily"      Value="{StaticResource FontUI}" />
        <Setter Property="FontSize"        Value="{StaticResource FontSizeBody}" />
        <Setter Property="Background"      Value="{StaticResource FieldBackground}" />
        <Setter Property="Foreground"      Value="{StaticResource TextSecondary}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CornerMedium}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource OverlayBackground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cancel — centered field-color, background-change hover -->
    <Style x:Key="CancelButtonStyle" TargetType="Button">
        <Setter Property="Cursor"          Value="Hand" />
        <Setter Property="FontFamily"      Value="{StaticResource FontUI}" />
        <Setter Property="FontSize"        Value="{StaticResource FontSizeBody}" />
        <Setter Property="Background"      Value="{StaticResource FieldBackground}" />
        <Setter Property="Foreground"      Value="{StaticResource TextSecondary}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CornerMedium}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource OverlayBackground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!-- LOADING STATE (#94)                         -->
    <!-- ═══════════════════════════════════════════ -->

    <Style x:Key="LoadingBarStyle" TargetType="ProgressBar">
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Height"          Value="2" />
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="Foreground"      Value="{StaticResource AccentPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!-- EMPTY STATE (#93)                           -->
    <!-- ═══════════════════════════════════════════ -->

    <Style x:Key="EmptyStateBorderStyle" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource FieldBackground}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource CornerMedium}" />
        <Setter Property="Padding"         Value="24,20" />
    </Style>

    <Style x:Key="EmptyStateHeadingStyle" TargetType="TextBlock">
        <Setter Property="Foreground"          Value="{StaticResource TextMuted}" />
        <Setter Property="FontFamily"          Value="{StaticResource FontUI}" />
        <Setter Property="FontSize"            Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextAlignment"       Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="EmptyStateSubtextStyle" TargetType="TextBlock">
        <Setter Property="Foreground"          Value="{StaticResource TextDisabled}" />
        <Setter Property="FontFamily"          Value="{StaticResource FontUI}" />
        <Setter Property="FontSize"            Value="{StaticResource FontSizeSmall}" />
        <Setter Property="TextAlignment"       Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextWrapping"        Value="Wrap" />
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!-- STATUS BANNER STYLES (#95, #98)             -->
    <!-- ═══════════════════════════════════════════ -->

    <Style x:Key="ErrorBannerStyle" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource StatusErrorBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource StatusErrorBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource CornerMedium}" />
        <Setter Property="Padding"         Value="14,10" />
    </Style>

    <Style x:Key="SuccessBannerStyle" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource StatusSuccessBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource StatusSuccessBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource CornerMedium}" />
        <Setter Property="Padding"         Value="14,10" />
    </Style>

    <Style x:Key="WarningBannerStyle" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource StatusWarningBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource StatusWarningBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource CornerMedium}" />
        <Setter Property="Padding"         Value="14,10" />
    </Style>

    <Style x:Key="InfoBannerStyle" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource StatusInfoBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource StatusInfoBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource CornerMedium}" />
        <Setter Property="Padding"         Value="14,10" />
    </Style>

</ResourceDictionary>
