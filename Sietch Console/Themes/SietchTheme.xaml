<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:converters="clr-namespace:Sietch_Console.Converters">

    <!-- ═══════════════════════════════════════════ -->
    <!-- VALUE CONVERTERS                            -->
    <!-- ═══════════════════════════════════════════ -->

    <converters:NullToCollapsedConverter       x:Key="NullToCollapsedConverter" />
    <converters:BoolToVisibleConverter         x:Key="BoolToVisibleConverter" />
    <converters:BoolToCollapsedConverter       x:Key="BoolToCollapsedConverter" />
    <converters:BoolInverseConverter           x:Key="BoolInverseConverter" />
    <converters:PathToFileNameConverter        x:Key="PathToFileNameConverter" />
    <converters:FileSizeConverter              x:Key="FileSizeConverter" />
    <converters:ResourceKeyToGeometryConverter x:Key="ResourceKeyToGeometryConverter" />

    <!-- ═══════════════════════════════════════════ -->
    <!-- BRAND COLOR TOKENS  (raw Color resources)   -->
    <!-- Aligned to Sietch Console Brand Board v1.0  -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- Primary surface ramp -->
    <Color x:Key="ColorVoid">#FF06090C</Color>
    <Color x:Key="ColorOnyx">#FF0B0F14</Color>
    <Color x:Key="ColorCharcoal">#FF141A22</Color>
    <Color x:Key="ColorIron">#FF232B35</Color>
    <Color x:Key="ColorIronTwo">#FF1A212B</Color>

    <!-- Brand accents -->
    <Color x:Key="ColorSandstone">#FFD6B98C</Color>
    <Color x:Key="ColorSpice">#FFC46A2B</Color>
    <Color x:Key="ColorAmber">#FFE0A64B</Color>

    <!-- Secondary tonal range -->
    <Color x:Key="ColorDustBeige">#FFE8D7B5</Color>
    <Color x:Key="ColorMutedCyan">#FF4FB3B8</Color>
    <Color x:Key="ColorDeepTeal">#FF1F6F73</Color>
    <Color x:Key="ColorAshBrown">#FF4A3A2A</Color>
    <Color x:Key="ColorFadedSand">#FF9C8564</Color>
    <Color x:Key="ColorViolet">#FF887CF6</Color>

    <!-- Wordmark gold gradient stops (used by BrandResources logo) -->
    <Color x:Key="ColorGoldHigh">#FFF4D49A</Color>
    <Color x:Key="ColorGoldMid">#FFE0A64B</Color>
    <Color x:Key="ColorGoldLow">#FFC46A2B</Color>

    <!-- ═══════════════════════════════════════════ -->
    <!-- BACKGROUND BRUSHES                          -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- Deep Onyx — main window and view backgrounds -->
    <SolidColorBrush x:Key="AppBackground"     Color="{StaticResource ColorOnyx}" />
    <!-- Charcoal Slate — panels, cards, sidebar -->
    <SolidColorBrush x:Key="PanelBackground"   Color="{StaticResource ColorCharcoal}" />
    <!-- Panel Dark — inner surfaces, log stream header -->
    <SolidColorBrush x:Key="SurfaceBackground" Color="#FF111820" />
    <!-- Near-black — log stream body -->
    <SolidColorBrush x:Key="DeepBackground"    Color="#FF0A0D11" />
    <!-- Void — drop-shadow / behind-canvas -->
    <SolidColorBrush x:Key="VoidBackground"    Color="{StaticResource ColorVoid}" />
    <!-- Dark overlay — input fields, depressed surfaces -->
    <SolidColorBrush x:Key="FieldBackground"   Color="#FF0F151C" />
    <!-- Subtle blue-dark — hover states, selected overlays -->
    <SolidColorBrush x:Key="OverlayBackground" Color="#FF1A2030" />
    <!-- Slightly lifted — nav item selected state -->
    <SolidColorBrush x:Key="SelectionBackground" Color="#FF1F2A36" />
    <!-- Nav item hover -->
    <SolidColorBrush x:Key="HoverBackground"   Color="#FF191F29" />
    <!-- Card surface — elevated above AppBackground, below PanelBackground -->
    <SolidColorBrush x:Key="CardBackground"    Color="{StaticResource ColorIronTwo}" />

    <!-- ═══════════════════════════════════════════ -->
    <!-- BORDER BRUSHES                              -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- Iron Gray — default card and panel borders -->
    <SolidColorBrush x:Key="BorderDefault" Color="{StaticResource ColorIron}" />
    <!-- Slightly lighter — subtle dividers -->
    <SolidColorBrush x:Key="BorderSubtle"  Color="#FF26313D" />
    <!-- Hairline — sandstone @ 18% on dark, for premium dividers -->
    <SolidColorBrush x:Key="BorderHairline" Color="#2EFF000000" />
    <!-- Ash Brown — warm subtle borders -->
    <SolidColorBrush x:Key="BorderWarm"    Color="{StaticResource ColorAshBrown}" />
    <!-- Faded Sand — for icon strokes & callouts -->
    <SolidColorBrush x:Key="BorderSand"    Color="{StaticResource ColorFadedSand}" />

    <!-- ═══════════════════════════════════════════ -->
    <!-- ACCENT BRUSHES                              -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- Spice Orange — primary actions, active states, logo mark -->
    <SolidColorBrush x:Key="AccentPrimary"    Color="{StaticResource ColorSpice}" />
    <!-- Sandstone — headings and warm highlights -->
    <SolidColorBrush x:Key="AccentSandstone"  Color="{StaticResource ColorSandstone}" />
    <!-- Dune Amber — warnings, attention states -->
    <SolidColorBrush x:Key="AccentAmber"      Color="{StaticResource ColorAmber}" />
    <!-- Dust Beige — soft highlight -->
    <SolidColorBrush x:Key="AccentDustBeige"  Color="{StaticResource ColorDustBeige}" />
    <!-- Muted Cyan — info, networking, system signals -->
    <SolidColorBrush x:Key="AccentCyan"       Color="{StaticResource ColorMutedCyan}" />
    <!-- Deep Teal — secondary actions -->
    <SolidColorBrush x:Key="AccentTeal"       Color="{StaticResource ColorDeepTeal}" />
    <!-- Violet Signal — update/maintenance states -->
    <SolidColorBrush x:Key="AccentViolet"     Color="{StaticResource ColorViolet}" />
    <!-- Faded Sand — neutral icon stroke -->
    <SolidColorBrush x:Key="AccentFadedSand"  Color="{StaticResource ColorFadedSand}" />

    <!-- Gold gradient brush for the wordmark / logo mark -->
    <LinearGradientBrush x:Key="GoldGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.00" Color="{StaticResource ColorGoldHigh}" />
        <GradientStop Offset="0.35" Color="{StaticResource ColorGoldMid}" />
        <GradientStop Offset="1.00" Color="{StaticResource ColorGoldLow}" />
    </LinearGradientBrush>

    <!-- Horizontal gold sweep — for accent rules / progress -->
    <LinearGradientBrush x:Key="GoldSweep" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Offset="0.00" Color="{StaticResource ColorAmber}" />
        <GradientStop Offset="1.00" Color="{StaticResource ColorSpice}" />
    </LinearGradientBrush>

    <!-- Dune gradient — for inner accents on the mark -->
    <LinearGradientBrush x:Key="DuneGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.00" Color="#FF9A4F1B" />
        <GradientStop Offset="1.00" Color="#FF5C2D0E" />
    </LinearGradientBrush>

    <!-- ═══════════════════════════════════════════ -->
    <!-- TEXT BRUSHES                                -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- Warm near-white — primary readable text -->
    <SolidColorBrush x:Key="TextPrimary"   Color="#FFF3EBDD" />
    <!-- Warm mid — secondary and body text -->
    <SolidColorBrush x:Key="TextSecondary" Color="#FFB8AA92" />
    <!-- Muted warm — labels, captions, helper text -->
    <SolidColorBrush x:Key="TextMuted"     Color="#FF7B6F5D" />
    <!-- Dark gray — disabled and placeholder text -->
    <SolidColorBrush x:Key="TextDisabled"  Color="#FF4A4F5A" />

    <!-- ═══════════════════════════════════════════ -->
    <!-- STATUS BRUSHES                              -->
    <!-- ═══════════════════════════════════════════ -->

    <!-- Soft Fremen Green — healthy / pass / complete -->
    <SolidColorBrush x:Key="StatusSuccess"  Color="#FF58B878" />
    <!-- Dune Amber — attention needed / warning -->
    <SolidColorBrush x:Key="StatusWarning"  Color="{StaticResource ColorAmber}" />
    <!-- Deep Signal Red — failure / error / blocked -->
    <SolidColorBrush x:Key="StatusError"    Color="#FFD9534F" />
    <!-- Muted Cyan — informational -->
    <SolidColorBrush x:Key="StatusInfo"     Color="{StaticResource ColorMutedCyan}" />
    <!-- Dust Gray — stopped / offline / unavailable -->
    <SolidColorBrush x:Key="StatusOffline"  Color="#FF6E747C" />
    <!-- Spice Orange — active / running -->
    <SolidColorBrush x:Key="StatusRunning"  Color="{StaticResource ColorSpice}" />
    <!-- Violet Signal — updating / maintenance -->
    <SolidColorBrush x:Key="StatusUpdating" Color="{StaticResource ColorViolet}" />

    <!-- ═══════════════════════════════════════════ -->
    <!-- STATUS BACKGROUND BRUSHES (tinted cards)    -->
    <!-- ═══════════════════════════════════════════ -->

    <SolidColorBrush x:Key="StatusSuccessBg"     Color="#FF1A2A1A" />
    <SolidColorBrush x:Key="StatusSuccessBorder" Color="#FF2A3D2A" />
    <SolidColorBrush x:Key="StatusWarningBg"     Color="#FF2A2010" />
    <SolidColorBrush x:Key="StatusWarningBorder" Color="#FF3D3018" />
    <SolidColorBrush x:Key="StatusErrorBg"       Color="#FF2A1A1A" />
    <SolidColorBrush x:Key="StatusErrorBorder"   Color="#FF3D2A2A" />
    <SolidColorBrush x:Key="StatusInfoBg"        Color="#FF1A1F2A" />
    <SolidColorBrush x:Key="StatusInfoBorder"    Color="#FF2A3040" />
    <SolidColorBrush x:Key="StatusUpdatingBg"    Color="#FF1F1A2E" />
    <SolidColorBrush x:Key="StatusUpdatingBorder" Color="#FF2E2645" />

    <!-- ═══════════════════════════════════════════ -->
    <!-- TYPOGRAPHY                                  -->
    <!-- ═══════════════════════════════════════════ -->

    <FontFamily x:Key="FontUI">Segoe UI Variable, Segoe UI</FontFamily>
    <FontFamily x:Key="FontUISemibold">Segoe UI Variable Semibold, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="FontMono">Cascadia Mono, Cascadia Code, Consolas, Courier New</FontFamily>

    <sys:Double x:Key="FontSizeSmall">11</sys:Double>
    <sys:Double x:Key="FontSizeBody">13</sys:Double>
    <sys:Double x:Key="FontSizeSubheading">14</sys:Double>
    <sys:Double x:Key="FontSizeHeading">18</sys:Double>
    <sys:Double x:Key="FontSizeTitle">22</sys:Double>
    <sys:Double x:Key="FontSizeDisplay">32</sys:Double>

    <!-- ═══════════════════════════════════════════ -->
    <!-- CORNER RADII                                -->
    <!-- ═══════════════════════════════════════════ -->

    <CornerRadius x:Key="CornerSmall">4</CornerRadius>
    <CornerRadius x:Key="CornerMedium">6</CornerRadius>
    <CornerRadius x:Key="CornerLarge">8</CornerRadius>
    <CornerRadius x:Key="CornerRound">14</CornerRadius>

    <!-- ═══════════════════════════════════════════ -->
    <!-- TEXTBLOCK STYLES                            -->
    <!-- ═══════════════════════════════════════════ -->

    <Style x:Key="DisplayTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily"  Value="{StaticResource FontUISemibold}" />
        <Setter Property="FontSize"    Value="{StaticResource FontSizeDisplay}" />
        <Setter Property="FontWeight"  Value="SemiBold" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily"  Value="{StaticResource FontUI}" />
        <Setter Property="FontSize"    Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight"  Value="SemiBold" />
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize"   Value="{StaticResource FontSizeBody}" />
    </Style>

    <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource TextMuted}" />
        <Setter Property="FontFamily"  Value="{StaticResource FontUI}" />
        <Setter Property="FontSize"    Value="10" />
        <Setter Property="FontWeight"  Value="SemiBold" />
    </Style>

    <Style x:Key="MonoLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource TextMuted}" />
        <Setter Property="FontFamily"  Value="{StaticResource FontMono}" />
        <Setter Property="FontSize"    Value="{StaticResource FontSizeSmall}" />
    </Style>

    <Style x:Key="CardTitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource TextPrimary}" />
        <Setter Property="FontFamily"  Value="{StaticResource FontUI}" />
        <Setter Property="FontSize"    Value="{StaticResource FontSizeSubheading}" />
        <Setter Property="FontWeight"  Value="SemiBold" />
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize"   Value="{StaticResource FontSizeBody}" />
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        <Setter Property="FontFamily" Value="{StaticResource FontUI}" />
        <Setter Property="FontSize"   Value="12" />
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!-- BORDER STYLES                               -->
    <!-- ═══════════════════════════════════════════ -->

    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource CardBackground}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BorderSubtle}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource CornerLarge}" />
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!-- SIDEBAR NAVIGATION STYLES                   -->
    <!-- ═══════════════════════════════════════════ -->

    <Style x:Key="NavListBoxStyle" TargetType="ListBox">
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding"         Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility"   Value="Auto" />
    </Style>

    <Style x:Key="NavItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding"  Value="0" />
        <Setter Property="Margin"   Value="8,2" />
        <Setter Property="Cursor"   Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemBorder"
                            Height="40"
                            CornerRadius="{StaticResource CornerSmall}"
                            Background="Transparent">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path x:Name="ItemIcon"
                                  Data="{Binding Icon, Converter={StaticResource ResourceKeyToGeometryConverter}}"
                                  Stroke="{StaticResource TextMuted}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  SnapsToDevicePixels="True"
                                  UseLayoutRounding="True"
                                  VerticalAlignment="Center"
                                  Margin="12,0,10,0" />
                            <TextBlock x:Name="ItemLabel"
                                       Text="{Binding Label}"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="{StaticResource FontSizeBody}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource SelectionBackground}" />
                            <Setter TargetName="ItemLabel"  Property="Foreground" Value="{StaticResource TextPrimary}" />
                            <Setter TargetName="ItemIcon"   Property="Stroke"     Value="{StaticResource AccentPrimary}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsSelected"  Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource HoverBackground}" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!-- BUTTON STYLES                               -->
    <!-- ═══════════════════════════════════════════ -->

    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="Cursor"          Value="Hand" />
        <Setter Property="FontFamily"      Value="{StaticResource FontUI}" />
        <Setter Property="FontSize"        Value="{StaticResource FontSizeBody}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding"         Value="14,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CornerMedium}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.85" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background"  Value="{StaticResource AccentPrimary}" />
        <Setter Property="Foreground"  Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentPrimary}" />
        <Setter Property="FontWeight"  Value="SemiBold" />
    </Style>

    <Style x:Key="TealButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background"  Value="{StaticResource AccentTeal}" />
        <Setter Property="Foreground"  Value="{StaticResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentTeal}" />
    </Style>

    <Style x:Key="SuccessButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background"  Value="{StaticResource StatusSuccessBg}" />
        <Setter Property="Foreground"  Value="{StaticResource StatusSuccess}" />
        <Setter Property="BorderBrush" Value="{StaticResource StatusSuccessBorder}" />
        <Setter Property="FontWeight"  Value="SemiBold" />
    </Style>

    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background"  Value="{StaticResource StatusErrorBg}" />
        <Setter Property="Foreground"  Value="{StaticResource StatusError}" />
        <Setter Property="BorderBrush" Value="{StaticResource StatusErrorBorder}" />
        <Setter Property="FontWeight"  Value="SemiBold" />
    </Style>

    <Style x:Key="InfoButtonStyle" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background"  Value="{StaticResource StatusInfoBg}" />
        <Setter Property="Foreground"  Value="{StaticResource AccentCyan}" />
        <Setter Property="BorderBrush" Value="{StaticResource StatusInfoBorder}" />
        <Setter Property="FontWeight"  Value="SemiBold" />
    </Style>

    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="Cursor"          Value="Hand" />
        <Setter Property="FontFamily"      Value="{StaticResource FontUI}" />
        <Setter Property="FontSize"        Value="{StaticResource FontSizeBody}" />
        <Setter Property="Background"      Value="{StaticResource FieldBackground}" />
        <Setter Property="Foreground"      Value="{StaticResource TextSecondary}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CornerMedium}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource OverlayBackground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CancelButtonStyle" TargetType="Button">
        <Setter Property="Cursor"          Value="Hand" />
        <Setter Property="FontFamily"      Value="{StaticResource FontUI}" />
        <Setter Property="FontSize"        Value="{StaticResource FontSizeBody}" />
        <Setter Property="Background"      Value="{StaticResource FieldBackground}" />
        <Setter Property="Foreground"      Value="{StaticResource TextSecondary}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CornerMedium}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource OverlayBackground}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!-- LOADING STATE                                -->
    <!-- ═══════════════════════════════════════════ -->

    <Style x:Key="LoadingBarStyle" TargetType="ProgressBar">
        <Setter Property="IsIndeterminate" Value="True" />
        <Setter Property="Height"          Value="2" />
        <Setter Property="Background"      Value="Transparent" />
        <Setter Property="Foreground"      Value="{StaticResource AccentPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!-- EMPTY STATE                                  -->
    <!-- ═══════════════════════════════════════════ -->

    <Style x:Key="EmptyStateBorderStyle" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource FieldBackground}" />
        <Setter Property="BorderBrush"     Value="{StaticResource BorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource CornerMedium}" />
        <Setter Property="Padding"         Value="24,20" />
    </Style>

    <Style x:Key="EmptyStateHeadingStyle" TargetType="TextBlock">
        <Setter Property="Foreground"          Value="{StaticResource TextMuted}" />
        <Setter Property="FontFamily"          Value="{StaticResource FontUI}" />
        <Setter Property="FontSize"            Value="{StaticResource FontSizeBody}" />
        <Setter Property="TextAlignment"       Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="EmptyStateSubtextStyle" TargetType="TextBlock">
        <Setter Property="Foreground"          Value="{StaticResource TextDisabled}" />
        <Setter Property="FontFamily"          Value="{StaticResource FontUI}" />
        <Setter Property="FontSize"            Value="{StaticResource FontSizeSmall}" />
        <Setter Property="TextAlignment"       Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextWrapping"        Value="Wrap" />
    </Style>

    <!-- ═══════════════════════════════════════════ -->
    <!-- STATUS BANNER STYLES                         -->
    <!-- ═══════════════════════════════════════════ -->

    <Style x:Key="ErrorBannerStyle" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource StatusErrorBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource StatusErrorBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource CornerMedium}" />
        <Setter Property="Padding"         Value="14,10" />
    </Style>

    <Style x:Key="SuccessBannerStyle" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource StatusSuccessBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource StatusSuccessBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource CornerMedium}" />
        <Setter Property="Padding"         Value="14,10" />
    </Style>

    <Style x:Key="WarningBannerStyle" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource StatusWarningBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource StatusWarningBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource CornerMedium}" />
        <Setter Property="Padding"         Value="14,10" />
    </Style>

    <Style x:Key="InfoBannerStyle" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource StatusInfoBg}" />
        <Setter Property="BorderBrush"     Value="{StaticResource StatusInfoBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius"    Value="{StaticResource CornerMedium}" />
        <Setter Property="Padding"         Value="14,10" />
    </Style>

</ResourceDictionary>
