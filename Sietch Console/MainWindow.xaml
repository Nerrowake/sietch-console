<Window x:Class="Sietch_Console.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Sietch_Console.ViewModels"
        xmlns:models="clr-namespace:SietchConsole.Core.Models;assembly=SietchConsole.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="Sietch Console"
        Icon="pack://application:,,,/Resources/AppIcon.ico"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        AutomationProperties.Name="Sietch Console — Dune Awakening Battlegroup Manager">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════ -->
        <!-- Header                                  -->
        <!-- ═══════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderDefault}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand lockup: mark + wordmark from BrandResources.xaml -->
                <ContentControl Grid.Column="0"
                                Template="{StaticResource AppLockupTemplate}"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Sietch Console" />

                <TextBlock Grid.Column="2"
                           Text="{Binding AppVersion}"
                           Foreground="{StaticResource TextMuted}"
                           FontFamily="{StaticResource FontUI}"
                           FontSize="{StaticResource FontSizeSmall}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- Update banner (#146) — visible when available  -->
        <!-- ═══════════════════════════════════════════════ -->
        <Border Grid.Row="1"
                Background="{StaticResource StatusWarningBg}"
                BorderBrush="{StaticResource StatusWarningBorder}"
                BorderThickness="0,0,0,1"
                Padding="16,8"
                Visibility="{Binding ShowUpdateBanner, Converter={StaticResource BoolToVisibleConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Banner text -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⬆ Update available: "
                               Foreground="{StaticResource AccentAmber}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeBody}"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding PendingUpdate.ReleaseName}"
                               Foreground="{StaticResource TextPrimary}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeBody}" />
                    <TextBlock Text="{Binding UpdateStatusMessage}"
                               Foreground="{StaticResource TextSecondary}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeSmall}"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"
                               Visibility="{Binding UpdateStatusMessage, Converter={StaticResource NullToCollapsedConverter}}" />
                </StackPanel>

                <!-- Download progress bar -->
                <ProgressBar Grid.Column="1"
                             Value="{Binding UpdateDownloadProgress}"
                             Minimum="0" Maximum="1"
                             Width="120" Height="6"
                             Background="{StaticResource OverlayBackground}"
                             Foreground="{StaticResource AccentAmber}"
                             VerticalAlignment="Center"
                             Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVisibleConverter}}" />

                <!-- Download & Install button -->
                <Button Grid.Column="3"
                        Command="{Binding DownloadAndInstallUpdateCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Padding="12,4"
                        IsEnabled="{Binding IsDownloadingUpdate, Converter={StaticResource BoolInverseConverter}}"
                        Visibility="{Binding PendingUpdate.InstallerDownloadUrl, Converter={StaticResource NullToCollapsedConverter}}">
                    <TextBlock Text="Download &amp; Install" />
                </Button>

                <!-- Dismiss -->
                <Button Grid.Column="5"
                        Command="{Binding DismissUpdateCommand}"
                        Style="{StaticResource CancelButtonStyle}"
                        Padding="10,4"
                        IsEnabled="{Binding IsDownloadingUpdate, Converter={StaticResource BoolInverseConverter}}">
                    <TextBlock Text="Later" />
                </Button>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════ -->
        <!-- Main area                               -->
        <!-- ═══════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderDefault}"
                    BorderThickness="0,0,1,0">
                <DockPanel>

                    <!-- ── Profile switcher (#139) ── -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,12">
                        <TextBlock Style="{StaticResource SectionLabelStyle}"
                                   Text="BATTLEGROUP"
                                   Margin="4,0,0,6" />

                        <!-- Profile ComboBox -->
                        <ComboBox ItemsSource="{Binding AllProfiles}"
                                  SelectedItem="{Binding SelectedProfile, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Background="{StaticResource FieldBackground}"
                                  Foreground="{StaticResource TextPrimary}"
                                  FontFamily="{StaticResource FontUI}"
                                  FontSize="{StaticResource FontSizeBody}"
                                  Margin="0,0,0,8" />

                        <!-- Status message -->
                        <TextBlock Text="{Binding ProfileStatusMessage}"
                                   Foreground="{StaticResource AccentTeal}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6"
                                   Visibility="{Binding ProfileStatusMessage, Converter={StaticResource NullToCollapsedConverter}}" />

                        <!-- Profile actions -->
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding OpenNewProfileOverlayCommand}"
                                    Style="{StaticResource TealButtonStyle}"
                                    Padding="10,5"
                                    Margin="0,0,6,0"
                                    IsEnabled="{Binding IsProfileSwitching, Converter={StaticResource BoolInverseConverter}}"
                                    ToolTip="Create a new battlegroup profile">
                                <TextBlock Text="+ New" />
                            </Button>
                            <Button Command="{Binding DeleteProfileCommand}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Padding="10,5"
                                    IsEnabled="{Binding CanDeleteProfile}"
                                    ToolTip="Delete the active battlegroup profile">
                                <TextBlock Text="Delete" />
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <!-- ── Navigation ── -->
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabelStyle}"
                                   Text="NAVIGATION"
                                   Margin="16,12,0,8" />

                        <ListBox ItemsSource="{Binding NavigationItems}"
                                 SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                                 Style="{StaticResource NavListBoxStyle}"
                                 ItemContainerStyle="{StaticResource NavItemStyle}"
                                 AutomationProperties.Name="Main navigation"
                                 KeyboardNavigation.TabNavigation="Once" />
                    </StackPanel>

                </DockPanel>
            </Border>

            <!-- Content region -->
            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentViewModel}" />

            <!-- ── New Profile overlay (#139) ── -->
            <Grid Grid.Column="0" Grid.ColumnSpan="2"
                  Background="#BB0B0F14"
                  Visibility="{Binding ShowNewProfileOverlay, Converter={StaticResource BoolToVisibleConverter}}">
                <Border Background="{StaticResource PanelBackground}"
                        BorderBrush="{StaticResource BorderDefault}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerLarge}"
                        Padding="28,24"
                        MaxWidth="420"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="New Battlegroup Profile"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="{StaticResource FontSizeSubheading}"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,16" />

                        <!-- Profile name -->
                        <TextBlock Text="Profile Name"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Margin="0,0,0,4" />
                        <Border Background="{StaticResource FieldBackground}"
                                BorderBrush="{StaticResource BorderDefault}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerSmall}"
                                Padding="10,8"
                                Margin="0,0,0,14">
                            <TextBox Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextPrimary}"
                                     FontFamily="{StaticResource FontUI}"
                                     FontSize="{StaticResource FontSizeBody}" />
                        </Border>

                        <!-- Install path -->
                        <TextBlock Text="Server Install Path"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   Margin="0,0,0,4" />
                        <Border Background="{StaticResource FieldBackground}"
                                BorderBrush="{StaticResource BorderDefault}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource CornerSmall}"
                                Padding="10,8"
                                Margin="0,0,0,20">
                            <TextBox Text="{Binding NewProfileInstallPath, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{StaticResource TextPrimary}"
                                     FontFamily="{StaticResource FontUI}"
                                     FontSize="{StaticResource FontSizeBody}" />
                        </Border>

                        <TextBlock Text="{Binding ProfileStatusMessage}"
                                   Foreground="{StaticResource AccentAmber}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="{StaticResource FontSizeSmall}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,14"
                                   Visibility="{Binding ProfileStatusMessage, Converter={StaticResource NullToCollapsedConverter}}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding CloseNewProfileOverlayCommand}"
                                    Style="{StaticResource CancelButtonStyle}"
                                    Margin="0,0,8,0"
                                    Padding="16,8">
                                <TextBlock Text="Cancel" />
                            </Button>
                            <Button Command="{Binding CreateProfileCommand}"
                                    Style="{StaticResource TealButtonStyle}"
                                    Padding="16,8"
                                    IsEnabled="{Binding CanCreateProfile}">
                                <TextBlock Text="Create" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>

        <!-- ═══════════════════════════════════════ -->
        <!-- Status bar                              -->
        <!-- ═══════════════════════════════════════ -->
        <Border Grid.Row="3"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderDefault}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- #98 — Profile name on the left -->
                <TextBlock Grid.Column="0"
                           Foreground="{StaticResource TextMuted}"
                           FontFamily="{StaticResource FontUI}"
                           FontSize="{StaticResource FontSizeSmall}"
                           VerticalAlignment="Center">
                    <TextBlock.Text>
                        <Binding Path="Dashboard.ProfileName"
                                 StringFormat="Active battlegroup: {0}" />
                    </TextBlock.Text>
                </TextBlock>

                <!-- #98 — Live battlegroup status on the right -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource StatusOffline}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Dashboard.Status}"
                                                 Value="{x:Static models:BattlegroupRuntimeStatus.Running}">
                                        <Setter Property="Fill" Value="{StaticResource StatusSuccess}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Dashboard.Status}"
                                                 Value="{x:Static models:BattlegroupRuntimeStatus.Starting}">
                                        <Setter Property="Fill" Value="{StaticResource StatusRunning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Dashboard.Status}"
                                                 Value="{x:Static models:BattlegroupRuntimeStatus.Stopping}">
                                        <Setter Property="Fill" Value="{StaticResource StatusWarning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Dashboard.Status}"
                                                 Value="{x:Static models:BattlegroupRuntimeStatus.Error}">
                                        <Setter Property="Fill" Value="{StaticResource StatusError}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Dashboard.StatusText}"
                               Foreground="{StaticResource TextMuted}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeSmall}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
