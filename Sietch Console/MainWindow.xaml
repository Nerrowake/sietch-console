<Window x:Class="Sietch_Console.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Sietch Console"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#0B0F14">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="48" />
            <!-- Main area: sidebar + content -->
            <RowDefinition Height="*" />
            <!-- Status bar -->
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════ -->
        <!-- Header                                  -->
        <!-- ═══════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="#141A22"
                BorderBrush="#232B35"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Branding: logo mark placeholder + app name -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Logo mark placeholder -->
                    <Border Width="24" Height="24"
                            Background="#C46A2B"
                            CornerRadius="4"
                            Margin="0,0,10,0" />
                    <TextBlock Text="Sietch Console"
                               Foreground="#F3EBDD"
                               FontFamily="Segoe UI Variable"
                               FontSize="15"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Version label -->
                <TextBlock Grid.Column="2"
                           Text="v0.1.0-alpha"
                           Foreground="#7B6F5D"
                           FontFamily="Segoe UI Variable"
                           FontSize="11"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════ -->
        <!-- Main area                               -->
        <!-- ═══════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar -->
                <ColumnDefinition Width="200" />
                <!-- Content region -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar placeholder (navigation implemented in #12) -->
            <Border Grid.Column="0"
                    Background="#141A22"
                    BorderBrush="#232B35"
                    BorderThickness="0,0,1,0">
                <StackPanel Margin="0,12,0,0">
                    <!-- Navigation section label -->
                    <TextBlock Text="NAVIGATION"
                               Foreground="#7B6F5D"
                               FontFamily="Segoe UI Variable"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Margin="16,0,0,8" />

                    <!-- Nav item placeholders -->
                    <Border Height="36" Margin="8,2"
                            Background="#1F2A36"
                            CornerRadius="4">
                        <TextBlock Text="Dashboard"
                                   Foreground="#F3EBDD"
                                   FontFamily="Segoe UI Variable"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="12,0" />
                    </Border>

                    <Border Height="36" Margin="8,2" CornerRadius="4">
                        <TextBlock Text="Setup Wizard"
                                   Foreground="#B8AA92"
                                   FontFamily="Segoe UI Variable"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="12,0" />
                    </Border>

                    <Border Height="36" Margin="8,2" CornerRadius="4">
                        <TextBlock Text="Logs"
                                   Foreground="#B8AA92"
                                   FontFamily="Segoe UI Variable"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="12,0" />
                    </Border>

                    <Border Height="36" Margin="8,2" CornerRadius="4">
                        <TextBlock Text="Diagnostics"
                                   Foreground="#B8AA92"
                                   FontFamily="Segoe UI Variable"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="12,0" />
                    </Border>

                    <Border Height="36" Margin="8,2" CornerRadius="4">
                        <TextBlock Text="Backups"
                                   Foreground="#B8AA92"
                                   FontFamily="Segoe UI Variable"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="12,0" />
                    </Border>

                    <Border Height="36" Margin="8,2" CornerRadius="4">
                        <TextBlock Text="Networking"
                                   Foreground="#B8AA92"
                                   FontFamily="Segoe UI Variable"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="12,0" />
                    </Border>

                    <Border Height="36" Margin="8,2" CornerRadius="4">
                        <TextBlock Text="Settings"
                                   Foreground="#B8AA92"
                                   FontFamily="Segoe UI Variable"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   Margin="12,0" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Content region (screens injected here by navigation) -->
            <Border Grid.Column="1"
                    Background="#0B0F14">
                <ContentPresenter x:Name="MainContentArea" />
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════ -->
        <!-- Status bar                              -->
        <!-- ═══════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="#141A22"
                BorderBrush="#232B35"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: application status -->
                <TextBlock Grid.Column="0"
                           Text="Ready"
                           Foreground="#7B6F5D"
                           FontFamily="Segoe UI Variable"
                           FontSize="11"
                           VerticalAlignment="Center" />

                <!-- Right: battlegroup status indicator placeholder -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8"
                             Fill="#6E747C"
                             Margin="0,0,6,0" />
                    <TextBlock Text="Battlegroup Offline"
                               Foreground="#7B6F5D"
                               FontFamily="Segoe UI Variable"
                               FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
