<Window x:Class="Sietch_Console.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Sietch_Console.ViewModels"
        xmlns:models="clr-namespace:SietchConsole.Core.Models;assembly=SietchConsole.Core"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="Sietch Console"
        Icon="pack://application:,,,/Resources/AppIcon.ico"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="920"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        AutomationProperties.Name="Sietch Console — Dune Awakening Battlegroup Manager">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════ -->
        <!-- Header                                  -->
        <!-- ═══════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderDefault}"
                BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- #91 — Geometric sietch doorway mark + wordmark -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Sietch Console">

                    <!-- Arch logo mark (100×110 native → scaled to 30×34) -->
                    <Viewbox Width="30" Height="34" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Grid Width="100" Height="110">

                            <!-- Arch frame: outer pillar+arch shape, inner doorway cutout (EvenOdd) -->
                            <Path>
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#F2C840" Offset="0"   />
                                        <GradientStop Color="#D08820" Offset="0.5" />
                                        <GradientStop Color="#A84C10" Offset="1"   />
                                    </LinearGradientBrush>
                                </Path.Fill>
                                <Path.Data>
                                    <GeometryGroup FillRule="EvenOdd">
                                        <!-- Outer boundary: pillars + arched top -->
                                        <PathGeometry>
                                            <PathFigure StartPoint="0,95" IsClosed="True">
                                                <LineSegment Point="0,42"/>
                                                <QuadraticBezierSegment Point1="50,-20" Point2="100,42"/>
                                                <LineSegment Point="100,95"/>
                                            </PathFigure>
                                        </PathGeometry>
                                        <!-- Inner boundary: arch opening (EvenOdd punch-out) -->
                                        <PathGeometry>
                                            <PathFigure StartPoint="22,95" IsClosed="True">
                                                <LineSegment Point="22,48"/>
                                                <QuadraticBezierSegment Point1="50,-8" Point2="78,48"/>
                                                <LineSegment Point="78,95"/>
                                            </PathFigure>
                                        </PathGeometry>
                                    </GeometryGroup>
                                </Path.Data>
                            </Path>

                            <!-- Door panels: two triangular wings inside the arch opening -->
                            <Path>
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#E8B030" Offset="0"   />
                                        <GradientStop Color="#B86018" Offset="0.6" />
                                        <GradientStop Color="#8C3C10" Offset="1"   />
                                    </LinearGradientBrush>
                                </Path.Fill>
                                <Path.Data>
                                    <GeometryGroup>
                                        <PathGeometry>
                                            <PathFigure StartPoint="22,50" IsClosed="True">
                                                <LineSegment Point="50,86"/>
                                                <LineSegment Point="22,95"/>
                                            </PathFigure>
                                        </PathGeometry>
                                        <PathGeometry>
                                            <PathFigure StartPoint="78,50" IsClosed="True">
                                                <LineSegment Point="50,86"/>
                                                <LineSegment Point="78,95"/>
                                            </PathFigure>
                                        </PathGeometry>
                                    </GeometryGroup>
                                </Path.Data>
                            </Path>

                            <!-- Dune accents at pillar bases -->
                            <Path>
                                <Path.Fill>
                                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                        <GradientStop Color="#C07018" Offset="0"/>
                                        <GradientStop Color="#8C3C10" Offset="1"/>
                                    </LinearGradientBrush>
                                </Path.Fill>
                                <Path.Data>
                                    <GeometryGroup>
                                        <PathGeometry>
                                            <PathFigure StartPoint="0,95" IsClosed="True">
                                                <LineSegment Point="11,84"/>
                                                <LineSegment Point="22,95"/>
                                            </PathFigure>
                                        </PathGeometry>
                                        <PathGeometry>
                                            <PathFigure StartPoint="78,95" IsClosed="True">
                                                <LineSegment Point="89,84"/>
                                                <LineSegment Point="100,95"/>
                                            </PathFigure>
                                        </PathGeometry>
                                    </GeometryGroup>
                                </Path.Data>
                            </Path>

                        </Grid>
                    </Viewbox>

                    <!-- Wordmark: "Sietch" + "— CONSOLE —" -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Sietch"
                                   Foreground="{StaticResource TextPrimary}"
                                   FontFamily="{StaticResource FontUI}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="— "
                                       Foreground="{StaticResource AccentSandstone}"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="9" />
                            <TextBlock Text="CONSOLE"
                                       Foreground="{StaticResource AccentSandstone}"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="9"
                                       FontWeight="SemiBold" />
                            <TextBlock Text=" —"
                                       Foreground="{StaticResource AccentSandstone}"
                                       FontFamily="{StaticResource FontUI}"
                                       FontSize="9" />
                        </StackPanel>
                    </StackPanel>

                </StackPanel>

                <TextBlock Grid.Column="2"
                           Text="v0.1.0-alpha"
                           Foreground="{StaticResource TextMuted}"
                           FontFamily="{StaticResource FontUI}"
                           FontSize="{StaticResource FontSizeSmall}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════ -->
        <!-- Main area                               -->
        <!-- ═══════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0"
                    Background="{StaticResource PanelBackground}"
                    BorderBrush="{StaticResource BorderDefault}"
                    BorderThickness="0,0,1,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionLabelStyle}"
                               Text="NAVIGATION"
                               Margin="16,12,0,8" />

                    <ListBox ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedNavigationItem, Mode=TwoWay}"
                             Style="{StaticResource NavListBoxStyle}"
                             ItemContainerStyle="{StaticResource NavItemStyle}"
                             AutomationProperties.Name="Main navigation"
                             KeyboardNavigation.TabNavigation="Once" />
                </StackPanel>
            </Border>

            <!-- Content region -->
            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentViewModel}" />
        </Grid>

        <!-- ═══════════════════════════════════════ -->
        <!-- Status bar                              -->
        <!-- ═══════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderDefault}"
                BorderThickness="0,1,0,0">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- #98 — Profile name on the left -->
                <TextBlock Grid.Column="0"
                           Foreground="{StaticResource TextMuted}"
                           FontFamily="{StaticResource FontUI}"
                           FontSize="{StaticResource FontSizeSmall}"
                           VerticalAlignment="Center">
                    <TextBlock.Text>
                        <Binding Path="Dashboard.ProfileName"
                                 StringFormat="Active battlegroup: {0}" />
                    </TextBlock.Text>
                </TextBlock>

                <!-- #98 — Live battlegroup status on the right -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource StatusOffline}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Dashboard.Status}"
                                                 Value="{x:Static models:BattlegroupRuntimeStatus.Running}">
                                        <Setter Property="Fill" Value="{StaticResource StatusSuccess}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Dashboard.Status}"
                                                 Value="{x:Static models:BattlegroupRuntimeStatus.Starting}">
                                        <Setter Property="Fill" Value="{StaticResource StatusRunning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Dashboard.Status}"
                                                 Value="{x:Static models:BattlegroupRuntimeStatus.Stopping}">
                                        <Setter Property="Fill" Value="{StaticResource StatusWarning}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Dashboard.Status}"
                                                 Value="{x:Static models:BattlegroupRuntimeStatus.Error}">
                                        <Setter Property="Fill" Value="{StaticResource StatusError}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding Dashboard.StatusText}"
                               Foreground="{StaticResource TextMuted}"
                               FontFamily="{StaticResource FontUI}"
                               FontSize="{StaticResource FontSizeSmall}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
