<Application x:Class="Sietch_Console.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sietch_Console.ViewModels"
             xmlns:views="clr-namespace:Sietch_Console.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/SietchTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- ViewModel → View DataTemplate routing -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SetupWizardViewModel}">
                <views:SetupWizardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:LogsViewModel}">
                <views:LogsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
                <views:DiagnosticsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BackupsViewModel}">
                <views:BackupsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:NetworkingViewModel}">
                <views:NetworkingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
